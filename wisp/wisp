IMAGE_MAGIC = (
    (b"\x89PNG\r\n\x1a\n", "image/png"),
    (b"\xff\xd8\xff", "image/jpeg"),
    (b"GIF87a", "image/gif"),
    (b"GIF89a", "image/gif"),
)
"""Fixed-offset image magic bytes and their media types. WebP is
not here: its magic is the RIFF....WEBP pair, checked separately in
sniff_image_media."""

def sniff_image_media(head: bytes) -> str | None:
    """The media type from the file's first bytes, or None when no
    supported image magic matches. The sniff reads bytes, not the
    file extension."""
    for magic, media in IMAGE_MAGIC:
        if head.startswith(magic):
            return media
    if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
        return "image/webp"
    return None

MAX_IMAGE_DIMENSION = 2000
"""The longest image side load_image keeps after a resize."""

MAX_IMAGE_BASE64_BYTES = 4500000
"""The base64 payload cap for one image. It stays below the 5MB
provider limit with headroom."""


def _pillow():
    """The PIL.Image class, or None when Pillow is not installed.
    Pillow is the one optional dependency: wisp imports it only when
    load_image must resize an image."""
    try:
        from PIL import Image
    except Exception:
        return None
    return Image


def _encoded_candidates(img: Any) -> list:
    """One PNG candidate and four JPEG candidates. PNG keeps
    transparency; JPEG gives the byte cap more room. The caller picks
    the smallest one that fits."""
    out = []
    buffer = io.BytesIO()
    img.save(buffer, format="PNG")
    out.append(("image/png", buffer.getvalue()))
    rgb = img.convert("RGB")
    for quality in (80, 70, 55, 40):
        buffer = io.BytesIO()
        rgb.save(buffer, format="JPEG", quality=quality)
        out.append(("image/jpeg", buffer.getvalue()))
    return out


def resize_image(raw: bytes, media: str) -> dict:
    """Fit one image into the default limits.

    Returns {"data", "media_type", "note"} on success, or {"error"}
    when the image cannot fit. An image within both limits keeps its
    exact bytes and gets an empty note. A resized image gets a note
    that names the original and displayed sizes, so the model can map
    coordinates back. The function tries PNG and JPEG encodings and
    shrinks the dimensions by 0.75 until a candidate fits.
    """
    encoded = base64.b64encode(raw).decode("ascii")
    if len(encoded) <= MAX_IMAGE_BASE64_BYTES:
        Image = _pillow()
        if Image is None:
            return {"data": encoded, "media_type": media, "note": ""}
        try:
            with Image.open(io.BytesIO(raw)) as probe:
                width, height = probe.size
        except Exception:
            return {"data": encoded, "media_type": media, "note": ""}
        if width <= MAX_IMAGE_DIMENSION and height <= MAX_IMAGE_DIMENSION:
            return {"data": encoded, "media_type": media, "note": ""}
    Image = _pillow()
    if Image is None:
        return {"error": "image is too large and Pillow is not installed"}
    try:
        from PIL import ImageOps
        img = Image.open(io.BytesIO(raw))
        img.load()
        img = ImageOps.exif_transpose(img)
    except Exception as exc:
        return {"error": "cannot read image (%s)" % exc}
    original_width, original_height = img.size
    width, height = original_width, original_height
    if width > MAX_IMAGE_DIMENSION:
        height = max(1, round(height * MAX_IMAGE_DIMENSION / width))
        width = MAX_IMAGE_DIMENSION
    if height > MAX_IMAGE_DIMENSION:
        width = max(1, round(width * MAX_IMAGE_DIMENSION / height))
        height = MAX_IMAGE_DIMENSION
    while True:
        resized = img.resize((width, height), Image.LANCZOS)
        best = None
        for candidate_media, blob in _encoded_candidates(resized):
            candidate = base64.b64encode(blob).decode("ascii")
            if len(candidate) > MAX_IMAGE_BASE64_BYTES:
                continue
            if best is None or len(candidate) < len(best[1]):
                best = (candidate_media, candidate)
        if best is not None:
            note = ("[Image: original %dx%d, displayed at %dx%d. "
                    "Multiply coordinates by %.2f to map to the original.]"
                    % (original_width, original_height, width, height,
                       original_width / width))
            return {"data": best[1], "media_type": best[0], "note": note}
        if width == 1 and height == 1:
            break
        width = max(1, int(width * 0.75))
        height = max(1, int(height * 0.75))
    return {"error": "image cannot fit the base64 byte cap"}


def load_attachments(world: World, paths: list | None) -> list:
    """One stored attachment per --attach path: name, sniffed
    media_type, and the file bytes as base64 data. Fails fast on a
    missing file or a file that is not a supported image, before any
    LLM call."""
    fs = world.get("fs")
    out = []
    for path in paths or []:
        if not fs.isfile(path):
            fail(world, "wisp run: --attach: no such file: %s" % path)
        raw = fs.read_bytes(path)
        media = sniff_image_media(raw[:16])
        if media is None:
            fail(world, "wisp run: --attach: not a supported image: %s"
                        % path)
        out.append({"name": os.path.basename(path),
                    "media_type": media,
                    "data": base64.b64encode(raw).decode("ascii")})
    return out

def data_uri_of(att: dict) -> str:
    """One stored attachment as a data URI, the form the
    openai dialects embed: 'data:<media_type>;base64,<data>'."""
    return "data:%s;base64,%s" % (att["media_type"], att["data"])

TOOL_STATUS_FIELDS = ("ms", "bytes", "offset", "rest_kb", "spill",
                      "timeout_s", "abandoned")
"""The tool-result status facts, in header and payload order."""

def tool_status_of(rec: dict) -> dict:
    """The status facts one tool record carries, in a fixed order.

    Only fields the record has are kept, so an old record with no
    measured duration replays as `wisp:tool bash exit=1`."""
    return {key: rec[key] for key in TOOL_STATUS_FIELDS
            if rec.get(key) is not None}

def tool_text_of(rec: dict) -> str:
    """The model-facing text of one tool record.

    One status header line, then the raw output. The header is derived
    from stored fields at wire time, so `content` stays raw in
    wisp.jsonl. Position authenticates the header: a command cannot
    print before its own output, so a forged `wisp:tool` line lands
    after the true one and reads as output."""
    parts = ["wisp:tool", rec.get("name") or "",
             "exit=%d" % int(rec.get("exit") or 0)]
    if rec.get("ms") is not None:
        parts.append("ms=%d" % int(rec["ms"]))
    if rec.get("spill"):
        parts += ["bytes=%d" % int(rec.get("bytes") or 0),
                  "offset=%d" % int(rec.get("offset") or 0),
                  "rest_kb=%d" % int(rec.get("rest_kb") or 0),
                  "spill=%s" % json.dumps(rec["spill"])]
    if rec.get("timeout_s") is not None:
        parts.append("timeout_s=%s" % rec["timeout_s"])
    if rec.get("abandoned"):
        parts.append("abandoned=1")
    content = rec.get("content") or ""
    if not content and not rec.get("spill"):
        parts.append("bytes=0")
    line = " ".join(parts)
    return line + "\n" + content if content else line

def message_of(rec: dict) -> dict:
    """Map one stored record to its wire message.

    text blocks join into content, reasoning blocks join into
    reasoning_content (replayed, not stripped, so the cache prefix
    hits), tool_call blocks keep their block order as tool_calls
    entries. Key order is stable across fresh and resumed runs.
    """
    kind = rec["type"]
    if kind == "assistant":
        text = "".join(b["text"] for b in rec["output"] if b["type"] == "text")
        reason = "".join(b["text"] for b in rec["output"] if b["type"] == "reasoning")
        calls = [
            {"id": b["id"], "type": "function",
             "function": {"name": b["name"], "arguments": b["arguments"]}}
            for b in rec["output"] if b["type"] == "tool_call"
        ]
        msg = {"role": "assistant", "content": text}
        if reason:
            msg["reasoning_content"] = reason
        if calls:
            msg["tool_calls"] = calls
        return msg
    if kind == "tool":
        return {"role": "tool", "tool_call_id": rec["call_id"],
                "content": tool_text_of(rec)}
    if kind == "user" and rec.get("attachments"):
        parts = [{"type": "text", "text": rec["content"]}]
        for att in rec["attachments"]:
            parts.append({"type": "image_url",
                          "image_url": {"url": data_uri_of(att)}})
        return {"role": "user", "content": parts}
    return {"role": kind, "content": rec["content"]}


def items_of_responses(rec: dict) -> list:
    """Map one stored record to openai-responses input items.

    A system record stays a developer message item. A user record is
    one user message item. An assistant record expands to a reasoning
    item per reasoning block - the stored summary text, plus the
    encrypted_content when the record holds one - then one message
    item for the text, then one function_call item per tool-call
    block, keyed by the stored id as call_id. A tool record is one
    function_call_output item keyed by the stored call_id. Key order
    is stable, so the serialized item list stays byte-stable across
    fresh and resumed runs. An unsigned reasoning item still replays
    its summary text; the Responses API does not require the blob.
    """
    kind = rec["type"]
    if kind == "system":
        return [{"role": "developer",
                 "content": [{"type": "input_text", "text": rec["content"]}]}]
    if kind == "user":
        parts = [{"type": "input_text", "text": rec["content"]}]
        for att in rec.get("attachments") or []:
            parts.append({"type": "input_image",
                          "image_url": data_uri_of(att)})
        return [{"role": "user", "content": parts}]
    if kind == "assistant":
        out = []
        for b in rec["output"]:
            if b["type"] == "reasoning":
                summary = ([{"type": "summary_text", "text": b["text"]}]
                           if b.get("text") else [])
                item = {"type": "reasoning", "summary": summary}
                if b.get("encrypted_content"):
                    item["encrypted_content"] = b["encrypted_content"]
                out.append(item)
            elif b["type"] == "text" and b["text"]:
                out.append({"type": "message", "role": "assistant",
                            "content": [{"type": "output_text",
                                         "text": b["text"]}]})
            elif b["type"] == "tool_call":
                out.append({"type": "function_call", "call_id": b["id"],
                            "name": b["name"], "arguments": b["arguments"]})
        return out
    if kind == "tool":
        text = tool_text_of(rec)
        if rec.get("attachments"):
            parts = [{"type": "input_text", "text": text}]
            for att in rec["attachments"]:
                parts.append({"type": "input_image",
                              "image_url": data_uri_of(att)})
            return [{"type": "function_call_output",
                     "call_id": rec["call_id"], "output": parts}]
        return [{"type": "function_call_output", "call_id": rec["call_id"],
                 "output": text}]
    return []


def items_of_anthropic(rec: dict) -> list:
    """Map one stored record to anthropic messages items.

    A system record maps to nothing here; anthropic_system_text lifts
    the system prompt to the top level. A user record is one user
    message with one text block. An assistant record expands to one
    thinking block per reasoning block - with its signature when the
    record holds one - then one text block, then one tool_use block
    per tool-call block; the API requires an unbroken run of the
    original thinking blocks, so every stored reasoning block replays
    in order, and a block without a signature is dropped: it cannot
    pass the signature check, and dropping from the run start is the
    legal removal. A tool record is one user message with one
    tool_result block. Key order is stable, so the serialized body
    stays byte-stable.
    """
    kind = rec["type"]
    if kind == "system":
        return []
    if kind == "user":
        content = [{"type": "text", "text": rec["content"]}]
        for att in rec.get("attachments") or []:
            content.append({"type": "image", "source": {
                "type": "base64", "media_type": att["media_type"],
                "data": att["data"]}})
        return [{"role": "user", "content": content}]
    if kind == "assistant":
        content = []
        for b in rec["output"]:
            if b["type"] == "reasoning":
                block = {"type": "thinking", "thinking": b["text"]}
                if b.get("signature"):
                    block["signature"] = b["signature"]
                else:
                    continue
                content.append(block)
            elif b["type"] == "text" and b["text"]:
                content.append({"type": "text", "text": b["text"]})
            elif b["type"] == "tool_call":
                content.append({"type": "tool_use", "id": b["id"],
                                "name": b["name"],
                                "input": json.loads(b["arguments"] or "{}")})
        if not content:
            return []
        return [{"role": "assistant", "content": content}]
    if kind == "tool":
        text = tool_text_of(rec)
        if rec.get("attachments"):
            content = [{"type": "text", "text": text}]
            for att in rec["attachments"]:
                content.append({"type": "image", "source": {
                    "type": "base64", "media_type": att["media_type"],
                    "data": att["data"]}})
            return [{"role": "user", "content": [
                {"type": "tool_result", "tool_use_id": rec["call_id"],
                 "content": content}]}]
        return [{"role": "user", "content": [
            {"type": "tool_result", "tool_use_id": rec["call_id"],
             "content": text}]}]
    return []


def body_of_chat(world: World, records: list) -> dict:
    """The openai-chat body.

    prompt_cache_key carries the session id, the routing hint OpenAI
    documents for the prefix cache. WISP_LLM_STREAM=false sends
    stream false and drops stream_options; every other key keeps its
    place, so the message prefix stays byte-stable.

    The steer tag applies to user text before message_of builds the
    message - the same pre-mapper surgery the other builders do - so
    a user record with attachments carries them in its text part and
    the image parts pass through. For text-only records the strings
    are byte-identical to the old post-mapper surgery."""
    messages = []
    pending_images = []
    for rec in records:
        wire_rec = rec
        if wire_rec.get("type") == "user":
            wire_rec = dict(wire_rec)
            wire_rec["content"] = user_text_of(wire_rec)
        if rec.get("type") == "tool":
            messages.append(message_of(wire_rec))
            pending_images.extend(rec.get("attachments") or [])
            continue
        if pending_images:
            messages.append(chat_image_message(pending_images))
            pending_images = []
        messages.append(message_of(wire_rec))
    if pending_images:
        messages.append(chat_image_message(pending_images))
    body = {
        "model": world.get("model"),
        "messages": messages,
        "tools": TOOLS_SPEC,
        "stream": stream_enabled_of(world),
    }
    if body["stream"]:
        body["stream_options"] = {"include_usage": True}
    thinking = world.get("thinking")
    if thinking:
        body["reasoning_effort"] = thinking
    cache_key = session_key_of(world)
    if cache_key:
        body["prompt_cache_key"] = cache_key
    return body


def chat_image_message(attachments: list) -> dict:
    """One user message that carries tool-result images.

    The openai-chat tool message takes text only, so the images go in
    one user message after the run of tool messages. The layer builds
    it at serialization time; no such record is ever stored.
    """
    content = [{"type": "text",
                "text": "Attached image(s) from tool result:"}]
    for att in attachments:
        content.append({"type": "image_url",
                        "image_url": {"url": data_uri_of(att)}})
    return {"role": "user", "content": content}


def user_text_of(rec: dict) -> str:
    """One user record's content with the steer tag applied."""
    text = rec["content"]
    if rec.get("wisp_steered"):
        text = "%s\n\n%s" % (STEER_TAG, text.rstrip("\n"))
    return text


def body_of_responses(world: World, records: list) -> dict:
    """The openai-responses body.

    Items come from items_of_responses. The steer tag applies to
    user text before the item list is built, so prefixes stay stable
    across rounds. The system text becomes the instructions field.
    store false keeps the run stateless, so include asks for the
    encrypted reasoning blob and each reasoning item carries the blob
    back. Thinking maps to reasoning.effort with the same level words
    the Responses API takes, and reasoning.summary auto asks for the
    readable summary wisp replays. prompt_cache_key carries the
    session id, the routing hint the vendor documents for the prefix
    cache.
    """
    input_items = []
    instructions = ""
    for rec in records:
        kind = rec.get("type")
        if kind == "system":
            instructions = ((instructions + "\n" if instructions else "")
                            + rec["content"])
            continue
        wire_rec = rec
        if kind == "user":
            wire_rec = dict(rec)
            wire_rec["content"] = user_text_of(rec)
        input_items.extend(items_of_responses(wire_rec))
    body = {
        "model": world.get("model"),
        "input": input_items,
        "tools": tools_spec_of("openai-responses"),
        "stream": True,
        "store": False,
        "include": ["reasoning.encrypted_content"],
    }
    cache_key = session_key_of(world)
    if cache_key:
        body["prompt_cache_key"] = cache_key
    if instructions:
        body["instructions"] = instructions
    thinking = world.get("thinking")
    if thinking:
        body["reasoning"] = {"effort": thinking, "summary": "auto"}
    return body


def body_of_anthropic(world: World, records: list) -> dict:
    """The anthropic messages body.

    Items come from items_of_anthropic; the system text lifts to
    the top level through anthropic_system_text over the system
    records. The steer tag applies to user text. One top-level
    cache_control marks the
    deepest stable prefix - the last record before the new user turn -
    so the conversation prefix, tools and system all cache; the
    breakpoint moves forward as the conversation grows. max_tokens
    carries the run cap. A thinking level turns adaptive thinking on
    and rides top-level output_config.effort, so Claude decides the
    depth and no budget_tokens enters the body. Only fields the
    messages API names are ever set.
    """
    messages = []
    system = ""
    owner = []  # message index -> source record index
    for ri, rec in enumerate(records):
        kind = rec.get("type")
        if kind == "system":
            system = ((system + "\n" if system else "")
                      + rec["content"])
            continue
        wire_rec = rec
        if kind == "user":
            wire_rec = dict(rec)
            wire_rec["content"] = user_text_of(rec)
        before = len(messages)
        messages.extend(items_of_anthropic(wire_rec))
        owner.extend([ri] * (len(messages) - before))
    body = {
        "model": world.get("model"),
        "messages": messages,
        "tools": tools_spec_of("anthropic"),
        "stream": True,
        "max_tokens": int(world.get("env").get(
            "WISP_LLM_MAX_TOKENS", DEFAULT_MAX_TOKENS)),
    }
    if system:
        body["system"] = system
    if messages:
        # two breakpoints: the last message, and the previous
        # request's last message - the one built from the record just
        # before the final assistant record, because that request held
        # every record up to there. A read walk checks its own
        # breakpoint position first, so marking where the previous
        # request wrote finds that entry at distance one on every
        # turn; the last-message mark writes the entry the next turn
        # will mark. Two of the four breakpoint slots are used.
        marks = [len(messages) - 1]
        last_assistant = max(
            (ri for ri, rec in enumerate(records)
             if rec.get("type") == "assistant"), default=None)
        if last_assistant and last_assistant > 0:
            prev = max(i for i, o in enumerate(owner)
                       if o == last_assistant - 1)
            if prev not in marks:
                marks.append(prev)
        for mi in marks:
            messages[mi].setdefault("content", [])
            if (isinstance(messages[mi]["content"], list)
                    and messages[mi]["content"]):
                messages[mi]["content"][-1].setdefault(
                    "cache_control", {"type": "ephemeral"})
    thinking = world.get("thinking")
    if thinking:
        body["thinking"] = {"type": "adaptive"}
        body["output_config"] = {"effort": thinking}
    return body


def build_request(world: World, records: list) -> dict:
    """Map stored turn records to the provider wire body. One choke point.

    The collapse is a lossless join, never a reorder. Key order is
    stable, so fresh and resumed run bodies serialize to the same
    bytes. The thinking level passes through unchanged; the endpoint
    rejects "off". stream_options.include_usage asks for the final
    usage chunk, which some providers hold back without it. A steered
    user message carries the STEER_TAG line before its content, so
    the model can tell steering from the turn prompt; the tag is
    stable per record, so prefixes stay stable too.
    """
    provider = provider_of(world)
    if provider != "openai-chat" and not stream_enabled_of(world):
        fail(world, "WISP_LLM_STREAM=false needs WISP_LLM_API=openai-chat"
             " (got %s)" % provider)
    if provider == "openai-chat":
        return body_of_chat(world, records)
    if provider == "openai-responses":
        return body_of_responses(world, records)
    return body_of_anthropic(world, records)


def error_text_of(line: str) -> str:
    """Extract the endpoint's error message from one JSON body line."""
    try:
        data = json.loads(line)
    except ValueError:
        return ""
    err = data.get("error") if isinstance(data, dict) else None
    if isinstance(err, dict):
        return err.get("message") or ""
    return str(err) if err is not None else ""


STOP_REASON_OF = {
    "end_turn": "stop", "stop_sequence": "stop", "tool_use": "tool_calls",
    "max_tokens": "length", "refusal": "content_filter",
}
"""anthropic stop_reason -> the finish_reason word the run loop reads."""


def responses_usage_of(usage: Any) -> dict | None:
    """One responses-shaped usage object as the internal chat shape.

    input_tokens_details.cached_tokens and cache_write_tokens map to
    prompt_tokens_details; output_tokens_details.reasoning_tokens maps
    to completion_tokens_details. A non-dict usage maps to None."""
    if not isinstance(usage, dict):
        return None
    details = usage.get("input_tokens_details") or {}
    out_details = usage.get("output_tokens_details") or {}
    prompt = int(usage.get("input_tokens") or 0)
    out = int(usage.get("output_tokens") or 0)
    return {
        "prompt_tokens": prompt,
        "completion_tokens": out,
        "total_tokens": int(usage.get("total_tokens") or prompt + out),
        "prompt_tokens_details": {
            "cached_tokens": int(details.get("cached_tokens") or 0),
            "cache_write_tokens": int(details.get("cache_write_tokens") or 0),
        },
        "completion_tokens_details": {
            "reasoning_tokens": int(out_details.get("reasoning_tokens") or 0),
        },
    }


def anthropic_usage_of(usage: Any) -> dict | None:
    """One anthropic-shaped usage object as the internal chat shape.

    cache_read_input_tokens maps to cached_tokens,
    cache_creation_input_tokens to cache_write_tokens, and
    prompt_tokens sums the three input parts, so net tokens stay
    honest. A non-dict usage maps to None."""
    if not isinstance(usage, dict):
        return None
    read = int(usage.get("cache_read_input_tokens") or 0)
    write = int(usage.get("cache_creation_input_tokens") or 0)
    inp = int(usage.get("input_tokens") or 0)
    out = int(usage.get("output_tokens") or 0)
    return {
        "prompt_tokens": inp + read + write,
        "completion_tokens": out,
        "total_tokens": inp + read + write + out,
        "prompt_tokens_details": {
            "cached_tokens": read, "cache_write_tokens": write},
        "completion_tokens_details": {},
    }


def responses_chunk_of(payload: dict) -> dict | None:
    """One responses stream event as one chat-shaped chunk, or None
    when the event carries no turn content.

    output_text and reasoning deltas map to content and reasoning;
    function_call items and argument deltas map to tool_calls by
    output_index; the completed event carries the normalized usage; a
    done reasoning item carries its encrypted_content for replay."""
    etype = payload.get("type") or ""
    if not etype.startswith("response."):
        return None
    if etype == "response.output_text.delta":
        return {"choices": [{"delta": {"content": payload.get("delta") or ""}}]}
    if etype in ("response.reasoning_text.delta",
                 "response.reasoning_summary_text.delta"):
        return {"choices": [{"delta": {"reasoning": payload.get("delta") or ""}}]}
    if etype == "response.output_item.added":
        item = payload.get("item") or {}
        if item.get("type") == "function_call":
            return {"choices": [{"delta": {"tool_calls": [{
                "index": payload.get("output_index", 0),
                "id": item.get("call_id"), "type": "function",
                "function": {"name": item.get("name") or "",
                             "arguments": ""}}]}}]}
        return None
    if etype == "response.function_call_arguments.delta":
        return {"choices": [{"delta": {"tool_calls": [{
            "index": payload.get("output_index", 0),
            "function": {"arguments": payload.get("delta") or ""}}]}}]}
    if etype == "response.output_item.done":
        item = payload.get("item") or {}
        if item.get("type") == "reasoning" and item.get("encrypted_content"):
            return {"choices": [{"delta": {
                "encrypted_content": item["encrypted_content"]}}]}
        return None
    if etype in ("response.completed", "response.done",
                 "response.incomplete"):
        response = payload.get("response") or {}
        items = response.get("output") or []
        called = any(isinstance(i, dict) and i.get("type") == "function_call"
                     for i in items)
        finish = ("tool_calls" if called
                  else "length" if etype == "response.incomplete"
                  else "stop")
        chunk = {"choices": [{"delta": {}, "finish_reason": finish}]}
        usage = responses_usage_of(response.get("usage"))
        if usage is not None:
            chunk["usage"] = usage
        return chunk
    return None


def anthropic_chunk_of(payload: dict) -> dict | None:
    """One anthropic stream event as one chat-shaped chunk, or None
    when the event carries no turn content.

    message_start and message_delta carry the normalized usage - the
    anthropic usage is cumulative, so the last chunk wins, which the
    accumulator already implements. content_block deltas map text,
    thinking, signature and partial_json to the matching fields; a
    tool_use block start maps to one tool_calls entry by block index;
    message_delta carries the mapped stop_reason. ping, message_stop
    and unknown event types map to None and are skipped."""
    etype = payload.get("type") or ""
    if etype == "message_start":
        usage = anthropic_usage_of((payload.get("message") or {}).get("usage"))
        return {"choices": [{"delta": {}}], "usage": usage} if usage else None
    if etype == "content_block_delta":
        delta = payload.get("delta") or {}
        dtype = delta.get("type")
        if dtype == "text_delta":
            return {"choices": [{"delta": {"content": delta.get("text") or ""}}]}
        if dtype == "thinking_delta":
            return {"choices": [{"delta": {"reasoning": delta.get("thinking") or ""}}]}
        if dtype == "signature_delta":
            return {"choices": [{"delta": {"signature": delta.get("signature") or ""}}]}
        if dtype == "input_json_delta":
            return {"choices": [{"delta": {"tool_calls": [{
                "index": payload.get("index", 0),
                "function": {"arguments": delta.get("partial_json") or ""}}]}}]}
        return None
    if etype == "content_block_start":
        block = payload.get("content_block") or {}
        if block.get("type") == "tool_use":
            return {"choices": [{"delta": {"tool_calls": [{
                "index": payload.get("index", 0), "id": block.get("id"),
                "type": "function",
                "function": {"name": block.get("name") or "",
                             "arguments": ""}}]}}]}
        return None
    if etype == "message_delta":
        delta = payload.get("delta") or {}
        chunk = {"choices": [{"delta": {}, "finish_reason": STOP_REASON_OF.get(
            delta.get("stop_reason"), "stop")}]}
        usage = anthropic_usage_of(payload.get("usage"))
        if usage is not None:
            chunk["usage"] = usage
        return chunk
    return None


def stream_error_of(payload: dict) -> str:
    """The error message inside one stream error event, or ''.

    Both the responses and the anthropic stream can carry an error
    object mid-stream; the message inside names the failure."""
    err = payload.get("error")
    if isinstance(err, dict):
        return err.get("message") or ""
    if err is not None:
        return str(err)
    response = payload.get("response")
    if isinstance(response, dict):
        err = response.get("error")
        if isinstance(err, dict):
            return err.get("message") or ""
    return ""


def chat_chunk_of(payload: Any) -> dict | None:
    """One non-stream chat-completion body as one chat-shaped chunk,
    or None when the body is not a JSON object with choices.

    message.content maps to delta.content and every present
    DEFAULT_THINK_FIELDS key copies over. Each message.tool_calls
    entry maps to delta.tool_calls with index set to its position:
    TurnAcc merges calls by index, so unindexed calls would collapse
    into one block with concatenated arguments. finish_reason and the
    top-level usage ride along."""
    if not isinstance(payload, dict):
        return None
    choices = payload.get("choices")
    if not isinstance(choices, list) or not choices:
        return None
    choice = choices[0] if isinstance(choices[0], dict) else {}
    message = choice.get("message")
    if not isinstance(message, dict):
        message = {}
    delta = {}
    content = message.get("content")
    if content:
        delta["content"] = content
    for field in DEFAULT_THINK_FIELDS.split(","):
        if message.get(field):
            delta[field] = message[field]
    calls = []
    for position, call in enumerate(message.get("tool_calls") or []):
        if not isinstance(call, dict):
            continue
        fn = call.get("function")
        if not isinstance(fn, dict):
            fn = {}
        calls.append({
            "index": position,
            "id": call.get("id"),
            "type": call.get("type") or "function",
            "function": {"name": fn.get("name"),
                         "arguments": fn.get("arguments") or ""},
        })
    if calls:
        delta["tool_calls"] = calls
    chunk = {"choices": [{"delta": delta,
                          "finish_reason": choice.get("finish_reason")}]}
    usage = payload.get("usage")
    if usage is not None:
        chunk["usage"] = usage
    return chunk


def chunk_of(provider: str, payload: dict) -> dict | None:
    """One stream payload as one chat-shaped chunk, or None.

    openai-chat keeps the payload as is when it carries choices; the
    other providers map through their event parser, which returns
    None for events with no turn content."""
    if provider == "openai-chat":
        return payload if isinstance(payload, dict) and "choices" in payload else None
    if provider == "openai-responses":
        return responses_chunk_of(payload)
    return anthropic_chunk_of(payload)


def trace_fields_of(meta: dict) -> list:
    """The response status and request id as wisp.log fields.

    Both come from Http.post_stream through sse_stream's meta dict.
    Each is absent until the endpoint answers, so a line logged
    before the response carries neither, and a transport failure
    with no response carries neither."""
    fields = []
    status = meta.get("status")
    if status is not None:
        fields.append("status=%s" % status)
    reqid = meta.get("request_id")
    if reqid:
        fields.append("reqid=%s" % reqid)
    return fields


def request_suffix_of(meta: dict) -> str:
    """One ' (request id: X)' tail for a failure text, or ''.

    The id names the request in the proxy log, so a failed run can
    be traced without a second failing request."""
    reqid = meta.get("request_id")
    return (" (request id: %s)" % reqid) if reqid else ""


def request_note_of(meta: dict) -> str:
    """One '; request id: X' tail for a parenthesized note, or ''."""
    reqid = meta.get("request_id")
    return ("; request id: %s" % reqid) if reqid else ""


def sse_stream(world: World, body: dict) -> Iterator[dict]:
    """Yield one parsed `data:` payload per chat-completion chunk.

    Raw `data:` lines stream to stdout as they arrive, the `data: [DONE]`
    marker is skipped, and unparseable payloads are skipped. Any other
    line (comment, blank separator) is dropped. A body with no
    `data:` line at all is not a chat-completion stream: the
    first body line, parsed for an error field if it is JSON, names
    the failure. An SSE stream that ends with no completion payload -
    the observed empty reply is a lone data marker - is an empty turn
    instead: it ends quietly after writing stream_note, and the
    degenerate guard asks again with a nudge. Every stream leaves
    its trace in wisp.log: one http post line before the request,
    one http_done line with line and payload counts after a clean
    end, one http_error line when the transport raises, and one
    streamfail line with the first body line and sse=yes or no when
    the body carried no choices payload - so a dead run can be told
    apart from a slow endpoint, a firewall block, or a wisp fault.
    Every line logged after the response carries the HTTP status and
    the endpoint request id, so the proxy log entry for a bad answer
    is one lookup away.
    """
    provider = provider_of(world)
    url = request_url_of(world)
    headers = auth_headers_of(world)
    http = world.get("http")
    meta = {}
    out = world.get("stdout")
    first_line = ""
    saw_data = False
    accepted = False
    started = world.get("clock").ms()
    lines = 0
    payloads = 0
    safe_log(world, "http", "post", "url=%s" % url,
             "bytes=%s" % len(json.dumps(body).encode("utf-8")))
    try:
        for line in http.post_stream(url, headers, body, meta):
            lines += 1
            if not first_line:
                first_line = line
            if not line.startswith("data:"):
                continue
            saw_data = True
            text = line[len("data:"):].lstrip()
            if text == "[DONE]":
                continue
            out.write(line + "\n")
            try:
                payload = json.loads(text)
            except ValueError:
                continue
            if not isinstance(payload, dict):
                continue
            err = stream_error_of(payload)
            if err:
                safe_log(world, "streamfail", "url=%s" % url,
                         "lines=%s" % lines, "payloads=%s" % payloads,
                         "first=%s" % err[:300], *trace_fields_of(meta))
                fail(world, "model endpoint returned a stream error: %s%s"
                     % (err, request_suffix_of(meta)))
            chunk = chunk_of(provider, payload)
            if chunk is not None:
                accepted = True
                payloads += 1
                yield chunk
    except HttpError as exc:
        safe_log(world, "http_error", "url=%s" % url,
                 "ms=%s" % (world.get("clock").ms() - started),
                 "lines=%s" % lines, "err=%s" % str(exc)[:300],
                 *trace_fields_of(meta))
        raise
    safe_log(world, "http_done", "url=%s" % url, "lines=%s" % lines,
             "payloads=%s" % payloads,
             "ms=%s" % (world.get("clock").ms() - started),
             *trace_fields_of(meta))
    if not accepted:
        detail = (error_text_of(first_line) or first_line
                  or "<empty body>")[:200]
        safe_log(world, "streamfail", "url=%s" % url, "lines=%s" % lines,
                 "payloads=%s" % payloads, "first=%s" % detail,
                 "sse=%s" % ("yes" if saw_data else "no"),
                 *trace_fields_of(meta))
        if not saw_data:
            fail(world, "model endpoint returned an unexpected response:"
                       " %s%s" % (detail, request_suffix_of(meta)))
        world.set("stream_note",
                  "the endpoint stream carried no completion payload"
                  " (lines=%s payloads=%s first line: %s%s)"
                  % (lines, payloads, detail, request_note_of(meta)))


def json_turn(world: World, body: dict) -> Iterator[dict]:
    """One non-stream chat request as a one-chunk turn.

    The whole body comes back in one read; chat_chunk_of turns it into
    the chunk shape TurnAcc eats, and one `data:` line prints, so
    wisp.stream, render-live and render-past need no new branch. The
    log lines match sse_stream: one http post line before the request,
    one http_error line on a transport failure, and one http_done line
    with mode=json on success. A body with an error object or no
    choices fails with the same 'model endpoint returned' wording
    sse_stream uses."""
    provider = provider_of(world)
    url = request_url_of(world)
    headers = auth_headers_of(world)
    http = world.get("http")
    meta = {}
    out = world.get("stdout")
    started = world.get("clock").ms()
    safe_log(world, "http", "post", "url=%s" % url,
             "bytes=%s" % len(json.dumps(body).encode("utf-8")))
    try:
        payload = http.post_json(url, headers, body, meta)
    except HttpError as exc:
        safe_log(world, "http_error", "url=%s" % url,
                 "ms=%s" % (world.get("clock").ms() - started),
                 "err=%s" % str(exc)[:300],
                 *trace_fields_of(meta))
        raise
    chunk = chat_chunk_of(payload)
    if chunk is None:
        detail = (stream_error_of(payload)
                  if isinstance(payload, dict) else "")
        raw = json.dumps(payload, ensure_ascii=False)
        detail = (detail or error_text_of(raw) or raw)[:200]
        safe_log(world, "streamfail", "url=%s" % url, "mode=json",
                 "first=%s" % detail, *trace_fields_of(meta))
        fail(world, "model endpoint returned an unexpected response:"
             " %s%s" % (detail, request_suffix_of(meta)))
    out.write("data: %s\n" % json.dumps(chunk, ensure_ascii=False))
    safe_log(world, "http_done", "url=%s" % url, "mode=json",
             "payloads=1", "ms=%s" % (world.get("clock").ms() - started),
             *trace_fields_of(meta))
    yield chunk


def turn_stream(world: World, body: dict) -> Iterator[dict]:
    """The one turn entry: streamed chunks, or one whole-body chunk
    when WISP_LLM_STREAM turns streaming off."""
    if stream_enabled_of(world):
        return sse_stream(world, body)
    return json_turn(world, body)


# --- skills and AGENTS.md ---------------------------------------------------------

SKILL_DIRS = (".wisp/skills", ".agents/skills", ".claude/skills")


def home_dir(env: Any) -> str:
    """HOME through the world; the expanduser fallback keeps the value
    exact when HOME is unset."""
    return env.get("HOME") or os.path.expanduser("~")


def expand_tilde(env: Any, path: str) -> str:
    """A leading ~ through the world's HOME; ~user forms stay on
    expanduser (pure string work, no IO)."""
    if path == "~":
        return home_dir(env)
    if path.startswith("~/"):
        return os.path.join(home_dir(env), path[2:])
    return os.path.expanduser(path)


def skill_roots(world: World) -> list:
    """Skill dirs in scan order; canonical scope scans last, so a
    project-local or user-local skill of the same name shadows it.

    Project scope walks from the current dir up to `git rev-parse
    --show-toplevel` (no walk outside a repo), then the user scope, then
    the XDG scope, then WISP_SYSTEM_SKILLS (default $HOME/.agents/skills).
    """
    fs, env = world.get("fs"), world.get("env")
    roots = []
    cwd = fs.cwd()

    project_root = git_root(world)
    if project_root and cwd.startswith(project_root):
        d = cwd
        while True:
            roots.extend(os.path.join(d, s) for s in SKILL_DIRS
                         if fs.isdir(os.path.join(d, s)))
            if d == project_root:
                break
            d = os.path.dirname(d)

    home = home_dir(env)
    roots.extend(os.path.join(home, s) for s in SKILL_DIRS
                 if fs.isdir(os.path.join(home, s)))

    xdg = env.get("XDG_CONFIG_HOME") or os.path.join(home, ".config")
    if fs.isdir(os.path.join(xdg, "skills")):
        roots.append(os.path.join(xdg, "skills"))
    for part in (env.get("XDG_CONFIG_DIRS") or "").split(":"):
        if part and fs.isdir(os.path.join(part, "skills")):
            roots.append(os.path.join(part, "skills"))

    for part in (env.get("WISP_SYSTEM_SKILLS",
                         os.path.join(home, ".agents/skills")) or "").split(":"):
        if part and fs.isdir(expand_tilde(env, part)):
            roots.append(expand_tilde(env, part))
    return roots


def collect_skills(world: World) -> list:
    """(name, description, path) triples, deduped by name and sorted.

    Subdirs that hold a SKILL.md count, symlinks followed, symlink-loop
    guarded by physical path. A dropped duplicate copy warns on stderr.
    """
    fs = world.get("fs")
    seen_paths, seen_names, found = set(), set(), []
    for root in skill_roots(world):
        try:
            entries = sorted(fs.listdir(root))
        except OSError:
            continue
        for entry in entries:
            path = os.path.join(root, entry, "SKILL.md")
            if not fs.isfile(path):
                continue
            phys = fs.realpath(path)
            if phys in seen_paths:
                continue
            seen_paths.add(phys)
            name, desc = skill_meta(world, path)
            if name in seen_names:
                world.get("stderr").write("wisp: dropping skill %s at %s\n" % (name, phys))
                continue
            seen_names.add(name)
            found.append((name, desc, phys))
    return sorted(found)


def resolve_skill_path(world: World, name: str) -> str:
    for skill_name, _desc, path in collect_skills(world):
        if skill_name == name:
            return path
    return ""


def skill_meta(world: World, path: str) -> tuple:
    """(name, description) from SKILL.md frontmatter.

    Handles plain, quoted, and block-scalar descriptions. The name falls
    back to the parent directory name.
    """
    name = desc = ""
    in_fm = block = False
    for line in world.get("fs").read_text(path).split("\n"):
        if not in_fm:
            if line == "---":
                in_fm = True
            continue
        if line == "---":
            break
        if block:
            if not line.strip():
                continue
            if line[:1] in (" ", "\t"):
                word = line.strip()
                desc = (desc + " " + word) if desc else word
                continue
            block = False
        field, _, value = line.partition(":")
        if field == "name":
            name = value.strip().strip("\"'")
        elif field == "description":
            value = value.strip()
            if value in ("|", "|-", ">", ">-"):
                block = True
                desc = ""
            else:
                desc = value.strip("\"'")
    if not name:
        name = os.path.basename(os.path.dirname(path))
    return name, desc


def strip_frontmatter(world: World, path: str) -> str:
    """The SKILL.md body with the frontmatter removed; a file that does
    not start with --- passes through unchanged."""
    lines = world.get("fs").read_text(path).split("\n")
    if not lines or lines[0] != "---":
        return "\n".join(lines)
    body, started = [], False
    for line in lines[1:]:
        if not started and line == "---":
            started = True
            continue
        if started:
            body.append(line)
    return "\n".join(body)


def skill_block(world: World, name: str, path: str) -> str:
    """The <skill> block; the exact text a system prompt carries."""
    body = strip_frontmatter(world, path).strip()
    return ('<skill name="%s" location="%s">\nReferences are relative to %s.\n\n%s\n</skill>'
            % (name, path, os.path.dirname(path), body))


def agents_md_files(world: World) -> list:
    """AGENTS.md and AGENTS.local.md files in ascending-priority
    order: the user files first, then the cwd ancestors from the root
    directory down to the CWD. When one directory holds both files,
    AGENTS.local.md goes after AGENTS.md. Later text carries more
    weight in LLMs, so the deepest, most project-local file sits
    last. Deduped by physical path with the first copy kept."""
    fs, env = world.get("fs"), world.get("env")
    docs = []
    home = os.path.join(home_dir(env), ".agents")
    for name in ("AGENTS.md", "AGENTS.local.md"):
        home_doc = os.path.join(home, name)
        if fs.isfile(home_doc):
            docs.append(home_doc)
    d = fs.cwd()
    stack = []
    while True:
        found = []
        for name in ("AGENTS.md", "AGENTS.local.md"):
            candidate = os.path.join(d, name)
            if fs.isfile(candidate):
                found.append(candidate)
        if found:
            stack.append(found)
        if d == os.path.dirname(d):
            break
        d = os.path.dirname(d)
    for found in reversed(stack):
        docs.extend(found)
    unique, seen = [], set()
    for path in docs:
        phys = fs.realpath(path)
        if phys in seen:
            continue
        seen.add(phys)
        unique.append(path)
    return unique


# --- renderer -----------------------------------------------------------------

THINK_LABEL = "[think]\n"
ANSWER_LABEL = "[answer]\n"


class Renderer:
    """Renders the run stdout stream (raw SSE plus injected tool records)
    to plain text: a `[think]` marker line opens each thinking block, an
    `[answer]` marker line opens each output block, each tool-call header
    tag line carries the command in a code fence below it, and each tool result prints
    the exact text the model receives, no colors. render-past replays
    committed system and user records through the prompt() path as a
    `[system]` or `[user]` marker line; the live stream never carries
    one. A
    steered user record replays through the steer() path as a `[steer]`
    marker line, the same shape the live drain injected."""

    def __init__(self, world: World):
        self._world = world
        self._think_fields = (
            world.get("env").get("WISP_THINK_FIELDS", DEFAULT_THINK_FIELDS).split(",")
        )
        self._out = world.get("stdout")
        self._last_kind = None
        self._labeled = False
        self._open_line = False

    def _before(self, kind: str) -> None:
        """One blank separator pair and a fresh label when the kind changes."""
        if self._last_kind is not None and self._last_kind != kind:
            self._out.write("\n\n")
            self._labeled = False
        self._last_kind = kind

    def _emit(self, label: str, text: str) -> None:
        """Open the block with its label once, then write the chunk raw."""
        if not self._labeled:
            self._out.write(label)
            self._labeled = True
        self._out.write(text)
        self._open_line = not text.endswith("\n")

    def render_line(self, line: str) -> None:
        if not line.startswith("data:"):
            return
        text = line[len("data:"):].lstrip()
        if not text or text == "[DONE]":
            return
        try:
            payload = json.loads(text)
        except ValueError:
            return
        if not isinstance(payload, dict):
            return
        marker = payload.get("wisp")
        if marker == "tool_call":
            self.tool_header(payload)
        elif marker == "tool_result":
            self.tool_result(payload)
        elif marker == "prompt":
            self.prompt(payload)
        elif marker == "steer":
            self.steer(payload)
        elif "choices" in payload:
            self.chunk(payload)

    def chunk(self, payload: dict) -> None:
        delta = next(iter(payload.get("choices") or []), {}).get("delta") or {}
        think = next((delta[f] for f in self._think_fields if delta.get(f)), "")
        if think:
            self._before("reasoning")
            self._emit(THINK_LABEL, think)
        content = delta.get("content")
        if content:
            self._before("text")
            self._emit(ANSWER_LABEL, content)

    def tool_header(self, payload: dict) -> None:
        """The [name 5s 5kb] tag line, then the command fenced in a
        triple-backtick block so it cannot join the tag line or the
        agent block below; a call with broken arguments shows ?s ?kB
        and the raw argument text."""
        name = payload.get("name", "tool")
        seconds = payload.get("timeoutSeconds", DEFAULT_TOOL_TIMEOUT)
        maxkb = payload.get("maxKilobytes", DEFAULT_TOOL_MAXKB)
        command = payload.get("command", "")
        self._before("tool_call")
        if name == "load_image":
            self._out.write("[load_image]\n")
        else:
            self._out.write("[%s %ss %skb]\n" % (name, seconds, maxkb))
        if command:
            self._out.write("```\n%s\n```\n" % command)
        self._open_line = False

    def tool_result(self, payload: dict) -> None:
        """Print the tool text the model receives: the `wisp:tool` status
        header line and the raw output below it. One rendering path, so a
        human reads the agent's view without a translation step."""
        text = tool_text_of(payload)
        self._out.write(text if text.endswith("\n") else text + "\n")
        # A tool result may leave a color or other SGR state active at its
        # end (the command never reset it, or the output cap cut off its
        # reset).  Close that state so it cannot bleed into later render
        # output.  ESC[0m with no active attributes is a no-op.
        self._out.write("\x1b[0m\n")
        self._last_kind = "tool_result"
        self._labeled = False
        self._open_line = False

    def prompt(self, payload: dict) -> None:
        """A committed prompt record: one `[role]` marker line, content below."""
        role = payload.get("role", "user")
        self._before(role)
        self._emit("[%s]\n" % role, payload.get("content", ""))

    def steer(self, payload: dict) -> None:
        """A steering message: one `[steer]` marker line, content below.
        The same shape as prompt, its own kind, so a steer never joins
        a user block above it."""
        self._before("steer")
        self._emit("[steer]\n", payload.get("content", ""))

    def finish(self) -> None:
        if self._open_line:
            self._out.write("\n")
        self._last_kind = None


def records_to_stream(records: list) -> Iterator[str]:
    """Yield one `data:` line per renderer payload, in the order the
    live stream carried it.

    Tools run sequentially in block order, so result N sits between
    header N and header N+1. Call headers are held back at the
    assistant record and released at their result's position, paired by
    call_id; a result with no id match takes the oldest pending header.
    A leftover header (a killed run's missing result) is released before
    the next record, where its command ran. A steered user record
    yields the steer payload the live drain injected, so render-past
    shows it with its [steer] marker."""
    def emit(payload: dict) -> str:
        return "data: %s\n" % json.dumps(payload, ensure_ascii=False)

    pending = []  # (call_id, inject payload) awaiting their result
    for rec in records:
        kind = rec.get("type")
        if kind != "tool" and pending:
            for _call_id, payload in pending:
                yield emit(payload)
            pending = []
        if kind == "assistant":
            for block in rec.get("output") or []:
                btype = block.get("type")
                if btype == "reasoning":
                    yield emit({"choices": [{"delta": {"reasoning_content": block.get("text", "")}}]})
                elif btype == "text":
                    yield emit({"choices": [{"delta": {"content": block.get("text", "")}}]})
                elif btype == "tool_call":
                    pending.append((block.get("id"), tool_call_inject(block)))
        elif kind in ("user", "system"):
            if kind == "user" and rec.get("wisp_steered"):
                yield emit({"wisp": "steer", "content": rec.get("content", "")})
            else:
                content = rec.get("content", "")
                for att in rec.get("attachments") or []:
                    content += "\n[attachment: %s, %s]" % (
                        att.get("name", ""), att.get("media_type", ""))
                yield emit({"wisp": "prompt", "role": kind,
                            "content": content})
        elif kind == "tool":
            call_id = rec.get("call_id")
            if pending:
                indexes = [i for i, (cid, _p) in enumerate(pending) if cid == call_id]
                yield emit(pending.pop(indexes[0] if indexes else 0)[1])
            payload = {"wisp": "tool_result", "name": rec.get("name", ""),
                       "call_id": call_id, "content": rec.get("content", ""),
                       "exit": rec.get("exit", 0)}
            payload.update(tool_status_of(rec))
            if rec.get("attachments"):
                payload["attachments"] = [
                    {"name": att.get("name", ""),
                     "media_type": att.get("media_type", "")}
                    for att in rec["attachments"]]
            yield emit(payload)
    for _call_id, payload in pending:
        yield emit(payload)


def tool_call_inject(block: dict) -> dict:
    """Recompute the tool_call inject payload from a stored block, with
    the same defaults and fallbacks Tools._execute_one used when it ran:
    ?s ?kB and the raw argument text when the arguments do not parse."""
    name = block.get("name") or ""
    try:
        args = json.loads(block.get("arguments") or "")
    except ValueError:
        args = None
    command = args.get("command") if isinstance(args, dict) else None
    if name == "load_image":
        path = args.get("path") if isinstance(args, dict) else None
        return {"wisp": "tool_call", "name": name,
                "command": path if isinstance(path, str) else ""}
    if name in ("bash", "python3") and isinstance(command, str):
        return {"wisp": "tool_call", "name": name,
                "timeoutSeconds": _int_or(args.get("timeoutSeconds"), DEFAULT_TOOL_TIMEOUT),
                "maxKilobytes": _int_or(args.get("maxKilobytes"), DEFAULT_TOOL_MAXKB),
                "command": command}
    return {"wisp": "tool_call", "name": name,
            "timeoutSeconds": "?", "maxKilobytes": "?",
            "command": command if isinstance(command, str)
            else (block.get("arguments") or "")}


IMPLS: dict[str, Callable[[World], Any]] = {
    "stdout": lambda w: Stdio(sys.stdout),
    "stderr": lambda w: Stdio(sys.stderr),
    "stdin": lambda w: StdinFile(sys.stdin),
    "env": env_impl,
    "fs": Fs,
    "clock": Clock,
    "rng": Rng,
    "http": Http,
    "exec": Executor,
    "session": Session,
    "llm": Llm,
    "tools": Tools,
    "context_guard": lambda w: None,
}


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    world = World(IMPLS)
    cmd = argv[0] if argv else "<none>"
    rc = 1
    try:
        if not argv or argv[0] in ("-h", "--help"):
            world.get("stdout").write(__doc__)
            rc = 0
        else:
            cmd, opts = parse_args(world, argv)
            rc = COMMANDS[cmd](world, opts)
    except BrokenPipeError:
        # The reader closed the pipe, the usual "wisp ls | head". Point
        # fd 1 at devnull so the interpreter's exit flush cannot raise a
        # second time, and exit 141, the SIGPIPE convention (128 + 13).
        try:
            os.dup2(os.open(os.devnull, os.O_WRONLY),
                    sys.stdout.fileno())
        except (AttributeError, OSError, ValueError):
            pass  # stdout without a real fd needs no redirect
        rc = 141
    except SignalExit as exc:
        world.get("stderr").write(
            "wisp: signal %s; committed wisp.jsonl; exit %s\n"
            % (exc.signum, 128 + exc.signum))
        rc = 128 + exc.signum
    except KeyboardInterrupt:
        # Ctrl-C: the run loop's finally already committed the tail;
        # exit 130, the SIGINT convention, without a traceback.
        world.get("stderr").write(
            "wisp: signal 2; committed wisp.jsonl; exit 130\n")
        rc = 130
    except HttpError as exc:
        fail(world, "http error: %s" % exc)
    except SystemExit as exc:
        rc = exc.code if isinstance(exc.code, int) else 1
    except Exception:
        # One unhandled crash: the traceback goes to wisp.log as one
        # crash line, so a dead run leaves the cause on disk even when
        # stderr is lost; the exit line in the finally then closes it.
        safe_log(world, "crash", traceback.format_exc().replace("\n", " | ")[:4000])
        world.get("stderr").write(
            "wisp: internal error; the traceback is in wisp.log\n")
        rc = 1
    finally:
        safe_log(world, "exit", "cmd=%s" % cmd,
                 "pid=%s" % os.getpid(), "rc=%s" % rc)
    return rc


if __name__ == "__main__":
    raise SystemExit(main())
