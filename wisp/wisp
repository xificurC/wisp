class Session:
    """The session files under world.get("sessiondir").

    load_events() -> (records, committed): resume from wisp.jsonl up to
      the commit point, or start a fresh log. On a fresh run the
      returned records are empty but nothing is on disk yet, so
      committed is 0 and the exit commit writes them.
    commit_events(new_records): append new records; the round loop
      and the exit commit both call it through flush_records, which
      owns the shared commit point in world.
    refresh_model_cfg(): best-effort copy of WISP_LLM_MODEL_INFO_FILE
      into wisp.modelcfg.
    log(event, *fields): one wisp.log line, ms UTC timestamp first.
    write_run_setup(path, model, thinking, parent): persist them;
      thinking and the parent link only when set.
    load_run_setup(path): read model/thinking back from wisp.run.json;
      fail when it is missing, not JSON, or has no model.
    write_initial_log(path, sysfile): create wisp.jsonl with the system
      record first when sysfile is given, plus an empty wisp.usage.
    """

    def __init__(self, world: World):
        self._world = world

    def write_run_setup(self, path: str, model: str, thinking: str | None,
                        parent: str | None = None) -> None:
        """Persist the run setup into <path>/wisp.run.json; thinking
        and the parent link only when set."""
        setup = {"model": model}
        if thinking:
            setup["thinking"] = thinking
        if parent:
            setup["parent"] = parent
        self._world.get("fs").write_text(
            path + "/wisp.run.json", json.dumps(setup, sort_keys=True) + "\n")

    def load_run_setup(self, path: str) -> dict:
        """Read the run setup from <path>/wisp.run.json."""
        world, fs = self._world, self._world.get("fs")
        cfgpath = path + "/wisp.run.json"
        if not fs.exists(cfgpath):
            fail(world, "session dir has no wisp.run.json: %s" % path)
        try:
            setup = json.loads(fs.read_text(cfgpath))
        except ValueError:
            fail(world, "wisp.run.json is not JSON: %s" % cfgpath)
        if not isinstance(setup, dict) or not setup.get("model"):
            fail(world, "wisp.run.json has no model: %s" % cfgpath)
        return setup

    def write_initial_log(self, path: str, system_text: str | None) -> None:
        """Create wisp.jsonl, the system record first when system_text is
        given, plus an empty wisp.usage."""
        world, fs = self._world, self._world.get("fs")
        records = []
        if system_text:
            records.append({"type": "system",
                            "content": system_text.rstrip("\n")})
        fs.write_text(path + "/wisp.jsonl", "".join(
            json.dumps(rec, ensure_ascii=False) + "\n" for rec in records))
        fs.write_text(path + "/wisp.usage", "")

    def load_events(self) -> tuple:
        world, fs, sessiondir = self._world, self._world.get("fs"), self._world.get("sessiondir")
        path = sessiondir + "/wisp.jsonl"
        fs.mkdir(sessiondir)

        if fs.exists(path) and fs.size(path):
            records = self._reload_committed(path)
            return records, len(records)
        fs.write_text(path, "")
        fs.write_text(sessiondir + "/wisp.usage", "")
        return [], 0

    def _reload_committed(self, path: str) -> list:
        """Rebuild committed records; drop a partial trailing tool round.

        An assistant record with tool_call blocks commits only when all
        of its tool records follow. A record that fails json.loads is a
        mid-commit kill; when anything is dropped the log is rewritten
        without it, so the next commit appends clean. Every drop writes
        one dropped line to wisp.log, so a lost tail is never silent.
        Raw segment records after the last assistant message are
        valid: a run killed mid-segment leaves its finished rounds on
        disk, and the next run loads them as plain history before its
        own prompt.
        """
        world, fs = self._world, self._world.get("fs")
        records, pending, results = [], None, []
        wanted = have = 0
        dropped = 0
        for line in fs.read_text(path).split("\n"):
            if not line.strip():
                continue  # the separator law: a trailing newline
            try:
                rec = json.loads(line)
            except ValueError:
                dropped += 1
                continue
            if not isinstance(rec, dict):
                dropped += 1
                continue
            kind = rec.get("type")
            if pending is not None and kind == "tool":
                results.append(rec)
                have += 1
                if have >= wanted:
                    records.append(pending)
                    records.extend(results)
                    pending, results, wanted, have = None, [], 0, 0
            elif kind == "assistant":
                count = sum(1 for b in rec.get("output") or []
                            if b.get("type") == "tool_call")
                if count:
                    pending = rec
                    wanted = count
                else:
                    records.append(rec)
            else:
                records.append(rec)
        if pending is not None:
            dropped += 1
        if dropped:
            self.log("dropped", "records=%s" % dropped)
            fs.replace_text(path, "".join(
                json.dumps(rec, ensure_ascii=False) + "\n" for rec in records))
        return records

    def commit_events(self, new_records: list) -> None:
        """Append the run's new records once, one JSON object per line.

        The separator law holds: a log that ends with a newline stays
        byte-identical when nothing appends. Each commit writes one
        commit line to wisp.log; a no-op commit writes none.
        """
        if not new_records:
            return
        fs = self._world.get("fs")
        path = self._world.get("sessiondir") + "/wisp.jsonl"
        if fs.exists(path) and fs.last_byte(path) not in (None, 10):
            fs.append_text(path, "\n")
        fs.append_text(path, "".join(
            json.dumps(rec, ensure_ascii=False) + "\n"
            for rec in new_records))
        self.log("commit", "records=%s" % len(new_records))

    def refresh_model_cfg(self) -> None:
        """Copy the WISP_LLM_MODEL_INFO_FILE table into wisp.modelcfg.

        The caller gets the file from the provider; wisp fetches no
        model info. The file holds one JSON object keyed by model, the
        shape wisp.modelcfg already has: context plus per-million
        input, output, cacheRead and cacheWrite. Unset means nothing
        happens and nothing warns. A missing, broken, or empty file
        warns on stderr and writes nothing, so a hand-written
        wisp.modelcfg survives."""
        world = self._world
        env = world.get("env")
        path = (env.get("WISP_LLM_MODEL_INFO_FILE") or "").strip()
        if not path:
            return
        path = expand_tilde(env, path)
        try:
            table = json.loads(world.get("fs").read_text(path))
        except (OSError, ValueError) as exc:
            self._modelcfg_warning(path, str(exc))
            return
        if not model_table_ok_of(table):
            self._modelcfg_warning(path, "not a JSON object of model entries")
            return
        world.get("fs").write_text(
            world.get("sessiondir") + "/wisp.modelcfg",
            json.dumps(table, sort_keys=True) + "\n")
        self.log("modelcfg", "written=1", "models=%s" % len(table))

    def _modelcfg_warning(self, path: str, detail: str) -> None:
        """One stderr line and one log line for a model-info file that
        did not load; the run keeps going."""
        self._world.get("stderr").write(
            "wisp: warning: cannot read model config from %s (%s)\n"
            % (path, detail[:300]))
        self.log("modelcfg", "error=%s" % detail[:300])

    def log(self, event: str, *fields: str) -> None:
        line = "%s %s %s\n" % (self._world.get("clock").ms(), event, " ".join(fields))
        self._world.get("fs").append_text(self._world.get("sessiondir") + "/wisp.log", line)


class Tools:
    """The bash, python3, and load_image tools.

    execute(calls) -> tool records, one per call, run order. Each call
    injects `data: {"wisp":"tool_call","name":...,"timeoutSeconds":...,
    "maxKilobytes":...,"command":...}` before it runs and
    `data: {"wisp":"tool_result","name":...,"call_id":...,"content":...,
    "exit":...,"ms":...}` after, plus the anomaly fields the record
    carries. Defaults: 5s timeout, 5kB output cap. A command
    at most 64kB runs through the -c argument with its head in memory;
    a bigger command or output beyond the cap goes to
    <sessiondir>/spill/<rand8>, and spill files are never deleted.
    """

    def __init__(self, world: World):
        self._world = world

    def execute(self, calls: list) -> list:
        return [self._execute_one(call) for call in calls]

    def _execute_one(self, call: dict) -> dict:
        world = self._world
        name = call.get("name") or ""
        record = {"type": "tool", "call_id": call.get("id"), "name": name,
                  "content": "", "exit": 0}
        safe_log(world, "tool", "start", "name=%s" % name,
                 "call_id=%s" % record["call_id"])
        try:
            args = json.loads(call.get("arguments") or "")
        except ValueError:
            args = None
        command = args.get("command") if isinstance(args, dict) else None
        started = world.get("clock").monotonic()
        if name == "load_image":
            path = args.get("path") if isinstance(args, dict) else None
            self._inject({"wisp": "tool_call", "name": name,
                          "command": path if isinstance(path, str) else ""})
            self._run_load_image(record, args if isinstance(args, dict) else {})
        elif name in ("bash", "python3") and isinstance(command, str):
            seconds = _int_or(args.get("timeoutSeconds"), DEFAULT_TOOL_TIMEOUT)
            maxkb = _int_or(args.get("maxKilobytes"), DEFAULT_TOOL_MAXKB)
            self._inject({"wisp": "tool_call", "name": name,
                          "timeoutSeconds": seconds, "maxKilobytes": maxkb,
                          "command": command})
            self._run_tool(record, name, command, seconds, maxkb)
        else:
            if name not in ("bash", "python3"):
                record["content"] = "wisp: unknown tool name '%s'" % name
            else:
                record["content"] = "wisp: tool call had no valid command argument"
            record["exit"] = 1
            self._inject({"wisp": "tool_call", "name": name,
                          "timeoutSeconds": "?", "maxKilobytes": "?",
                          "command": command if isinstance(command, str)
                          else (call.get("arguments") or "")})
        record["ms"] = max(0, int(round(
            (world.get("clock").monotonic() - started) * 1000)))
        safe_log(world, "tool", "end", "name=%s" % name,
                 "call_id=%s" % record["call_id"],
                 "exit=%s" % record["exit"],
                 "ms=%s" % record["ms"],
                 "bytes=%s" % len(record["content"]))
        payload = {"wisp": "tool_result", "name": name,
                   "call_id": record["call_id"], "content": record["content"],
                   "exit": record["exit"]}
        payload.update(tool_status_of(record))
        if record.get("attachments"):
            payload["attachments"] = [
                {"name": att["name"], "media_type": att["media_type"]}
                for att in record["attachments"]]
        self._inject(payload)
        return record

    def _run_load_image(self, record: dict, args: dict) -> None:
        """Read one image file into record["attachments"].

        The media type comes from the file bytes. A resize failure or
        an unsupported file degrades to a text note with exit 1, so
        the model learns why it cannot see the image.
        """
        world = self._world
        path = args.get("path")
        resize = args.get("resize", True)
        if not isinstance(resize, bool):
            resize = True
        if not isinstance(path, str) or not path:
            record["content"] = "wisp: load_image needs a path argument"
            record["exit"] = 1
            return
        fs = world.get("fs")
        if not fs.isfile(path):
            record["content"] = "wisp: load_image: no such file: %s" % path
            record["exit"] = 1
            return
        raw = fs.read_bytes(path)
        media = sniff_image_media(raw[:16])
        if media is None:
            record["content"] = (
                "wisp: load_image: not a supported image (png, jpeg, gif, "
                "webp): %s" % path)
            record["exit"] = 1
            return
        if resize:
            result = resize_image(raw, media)
        else:
            result = {"data": base64.b64encode(raw).decode("ascii"),
                      "media_type": media, "note": ""}
        if result.get("error"):
            record["content"] = "wisp: load_image: %s: %s" % (
                path, result["error"])
            record["exit"] = 1
            return
        record["attachments"] = [
            {"name": os.path.basename(path),
             "media_type": result["media_type"], "data": result["data"]}]
        lines = ["Loaded image: %s (%s, %d bytes)."
                 % (os.path.basename(path), result["media_type"], len(raw))]
        if result.get("note"):
            lines.append(result["note"])
        record["content"] = "\n".join(lines)

    def _run_tool(self, record: dict, name: str, command: str,
                  seconds: int, maxkb: int) -> None:
        """Run one command; fill content, exit, and the status fields.

        The spill branch records `spill`, `bytes`, `offset`, and
        `rest_kb`; a forced stop records `timeout_s`; an abandoned
        drain records `abandoned`. The record keeps facts, never prose.

        No file is created for a small, quick command: the head stays in
        memory. A spill file appears only when the output overflows the
        cap or the command itself exceeds 64kB; it is never deleted.
        """
        rc, head, spill_path, abandoned = self._world.get("exec").run(
            self._argv(name, command), seconds, maxkb * 1000, self._spill)
        record["exit"] = rc
        record["content"] = head.decode("utf-8", "replace")
        if spill_path:
            spill_size = self._world.get("fs").size(spill_path)
            cap_bytes = maxkb * 1000
            record["spill"] = spill_path
            record["bytes"] = spill_size
            record["offset"] = cap_bytes + 1
            record["rest_kb"] = (spill_size - cap_bytes + 999) // 1000
        if rc == 124:
            record["timeout_s"] = seconds
        if abandoned:
            record["abandoned"] = True

    def _argv(self, name: str, command: str) -> list:
        """[name, -c, command], or a spill-dir command file when the
        command itself would outgrow the OS per-argument limit."""
        if len(command.encode("utf-8")) <= 65536:
            return [name, "-c", command]
        cmd_file = self._spill()
        self._world.get("fs").write_text(cmd_file, command)
        return [name, cmd_file]

    def _spill(self) -> str:
        """One fresh spill path; the spill dir comes with it."""
        world = self._world
        spill_dir = world.get("sessiondir") + "/spill"
        world.get("fs").mkdir(spill_dir)
        return spill_dir + "/" + world.get("rng").token(8)

    def _inject(self, payload: dict) -> None:
        self._world.get("stdout").write(
            "data: %s\n" % json.dumps(payload, ensure_ascii=False))


# --- the LLM turn -------------------------------------------------------------

# --- llm provider layer ---------------------------------------------------------

# The provider layer maps one stored conversation to three wire formats
# and back, behind build_request, sse_stream and the turn accumulator.
# openai-chat keeps the byte-stable body the cache prefix needs; the
# other two keep the same invariant through per-provider stable key
# order. Every layer piece is a pure function of the records, so fresh
# and resumed runs serialize to the same bytes.

DEFAULT_MAX_TOKENS = 4096
"""The anthropic max_tokens cap per turn; WISP_LLM_MAX_TOKENS overrides."""

PROVIDERS = ("openai-chat", "openai-responses", "anthropic")

USER_AGENT = "wisp"
"""The request user agent: a client names itself, never the HTTP library.

urllib sends Python-urllib by default, which sits on blocklists - an
OpenCode Go turn answered 403 error code 1010 until wisp named itself.
WISP_LLM_HEADERS overrides the value."""


def provider_of(world: World) -> str:
    """The wire format for this run: WISP_LLM_API, default openai-chat.

    Read per run through the world env service, never stored in
    wisp.run.json, so old sessions keep their format until a caller
    opts in by env, and the body builder stays a pure function of
    the records plus the env.
    """
    try:
        env = world.get("env")
    except KeyError:
        env = {}
    api = (env.get("WISP_LLM_API") or "").strip() or "openai-chat"
    if api not in PROVIDERS:
        fail(world, "wisp: unknown WISP_LLM_API %s (use one of: %s)"
             % (api, ", ".join(PROVIDERS)))
    return api


STREAM_OFF_WORDS = ("false", "0", "no", "off")
"""WISP_LLM_STREAM values that turn one turn into one non-stream call."""


def stream_enabled_of(world: World) -> bool:
    """Whether this run asks the endpoint for one streamed response.

    WISP_LLM_STREAM unset or empty keeps the stream. false, 0, no and
    off (trimmed, any case) turn it off: the request carries
    stream: false and the whole turn prints as one chunk. Any other
    value fails, so a typo never changes the wire."""
    try:
        env = world.get("env")
    except KeyError:
        env = {}
    raw = (env.get("WISP_LLM_STREAM") or "").strip().lower()
    if not raw:
        return True
    if raw in STREAM_OFF_WORDS:
        return False
    fail(world, "unknown WISP_LLM_STREAM %s (leave it unset for a stream,"
         " or set false, 0, no or off)" % raw)


def session_key_of(world: World) -> str:
    """The session dir's base name: the stable conversation id.

    One conversation gets one id wherever a backend accepts one: the
    x-opencode-session header, the codex session-id header, and the
    prompt_cache_key body field. Two runs on one session dir share a
    route and a cache shard."""
    try:
        return os.path.basename(str(world.get("sessiondir")).rstrip("/"))
    except KeyError:
        return ""


def request_url_of(world: World) -> str:
    """The full request URL from WISP_LLM_URL; wisp appends nothing.

    The value carries scheme, host, path and query, so a version
    path, a deployment prefix, or a gateway prefix lands as written.
    Start checks: the scheme is http or https, and the path is not
    empty - a bare origin fails here instead of answering 404 later."""
    env = world.get("env")
    url = (env.get("WISP_LLM_URL") or "").strip()
    if not url:
        fail(world, "WISP_LLM_URL is not set")
    parts = urllib.parse.urlsplit(url)
    if parts.scheme not in ("http", "https"):
        fail(world, "WISP_LLM_URL needs an http or https URL: %s"
             % redact_query_of(url))
    if parts.path in ("", "/"):
        fail(world, "WISP_LLM_URL has no path: %s" % redact_query_of(url))
    return url


def extra_headers_of(world: World) -> dict:
    """The WISP_LLM_HEADERS overlay: one JSON object, applied last.

    A JSON null marks a deletion, not a None value: it removes the
    default header of that name, so a no-auth endpoint drops
    Authorization with {"Authorization": null}. A value may hold
    {session}, replaced by the session dir's base name, and {key},
    replaced by WISP_LLM_API_KEY, so a header carries the key without
    a second export. A value that is not a JSON object fails the run,
    because a header that silently does not apply would leave the
    endpoint's refusal unexplained. The raw value never prints in an
    error: an overlay may carry the key itself."""
    try:
        env = world.get("env")
    except KeyError:
        env = {}
    raw = (env.get("WISP_LLM_HEADERS") or "").strip()
    if not raw:
        return {}
    try:
        table = json.loads(raw)
    except ValueError as exc:
        fail(world, "WISP_LLM_HEADERS is not valid JSON (%s)" % exc)
    if not isinstance(table, dict):
        fail(world, "WISP_LLM_HEADERS is not a JSON object")
    return {str(name): (None if value is None else str(value))
            for name, value in table.items()}


def merged_headers(base: dict, extras: dict) -> dict:
    """Apply the overlay on the base table, names case-insensitive.

    A null value deletes the matching header. A non-null value
    replaces it under the overlay's spelling, so the export names the
    exact bytes on the wire. The base headers keep their order first."""
    for name, value in extras.items():
        match = next((key for key in base if key.lower() == name.lower()),
                     None)
        if match is not None:
            del base[match]
        if value is not None:
            base[name] = value
    return base


def auth_headers_of(world: World) -> dict:
    """The request headers for one turn, key check included.

    Every shape sends Content-Type, User-Agent and Authorization:
    Bearer {key}. WISP_LLM_HEADERS lands last, so a backend with
    another auth scheme replaces or deletes the Bearer header. The
    key check runs on the resolved table: a run fails only when a
    surviving value still holds {key} and WISP_LLM_API_KEY is empty,
    so a no-auth local endpoint needs no key at all."""
    key = world.get("env").get("WISP_LLM_API_KEY") or ""
    headers = merged_headers(
        {"Content-Type": "application/json",
         "User-Agent": USER_AGENT,
         "Authorization": "Bearer {key}"},
        extra_headers_of(world))
    if not key and any("{key}" in value for value in headers.values()):
        fail(world, "WISP_LLM_API_KEY is not set")
    session = session_key_of(world)
    return {name: value.replace("{session}", session).replace("{key}", key)
            for name, value in headers.items()}


def tools_spec_of(provider: str) -> list:
    """TOOLS_SPEC per provider: the nested OpenAI form for
    openai-chat, the flat tag form for openai-responses, and the
    name/description/input_schema form for anthropic. Key order is
    stable per provider, so the serialized prefix stays byte-stable."""
    if provider == "openai-chat":
        return TOOLS_SPEC
    out = []
    for tool in TOOLS_SPEC:
        fn = tool["function"]
        if provider == "openai-responses":
            out.append({"type": "function", "name": fn["name"],
                        "description": fn["description"],
                        "parameters": fn["parameters"]})
        else:
            out.append({"name": fn["name"],
                        "description": fn["description"],
                        "input_schema": fn["parameters"]})
    return out


def anthropic_system_text(records: list) -> str:
    """The joined system texts of the record list; the anthropic body
    carries the system prompt as one top-level string, not as a
    message."""
    return "\n".join(r["content"] for r in records if r.get("type") == "system")


class Llm:
    """One chat-completions turn at one level of intent, streamed or
    whole, depending on WISP_LLM_STREAM.

    turn(records) -> {"assistant": record, "finish_reason": str,
      "cached_tokens": int}. Usage chunk copies land in <sessiondir>/wisp.usage
      through the fs service, one plain JSON line per chunk.
    """

    def __init__(self, world: World):
        self._world = world
        self._think_fields = (
            world.get("env").get("WISP_THINK_FIELDS", DEFAULT_THINK_FIELDS).split(",")
        )

    def turn(self, records: list) -> dict:
        world = self._world
        body = build_request(world, records)
        acc = TurnAcc(self._think_fields)
        for payload in turn_stream(world, body):
            acc.apply_delta(payload)

        if acc.usage:
            usage_lines = "".join(
                "%s\n" % json.dumps(chunk, sort_keys=True) for chunk in acc.usage
            )
            world.get("fs").append_text(world.get("sessiondir") + "/wisp.usage", usage_lines)

        return {
            "assistant": {
                "type": "assistant",
                "output": acc.blocks,
                "finish_reason": acc.finish_reason,
                "usage": acc.usage,
            },
            "finish_reason": acc.finish_reason,
            "cached_tokens": acc.cached_tokens,
        }


class TurnAcc:
    """Captures one assistant turn without losing arrival order.

    The model can interleave reasoning, output, and tool-call bursts in
    any sequence; blocks land on acc.blocks in exactly that sequence. A
    same-kind burst continues the last block only while it is still the
    last block; every later burst opens a new one. Tool-call deltas merge
    by index; a call keeps its first id and name while arguments
    concatenate. finish_reason and cached_tokens take the last value seen.
    """

    def __init__(self, think_fields: list):
        self.think_fields = think_fields
        self.blocks = []
        self._reasoning_open = True
        self._calls = {}  # tool-call index -> block, arrival order in blocks
        self.finish_reason = ""
        self.cached_tokens = 0
        self.usage = []

    def _append_text(self, kind: str, value: str) -> None:
        merge = (self.blocks and self.blocks[-1].get("type") == kind
                 and (kind != "reasoning" or self._reasoning_open))
        if merge:
            self.blocks[-1]["text"] += value
        else:
            self.blocks.append({"type": kind, "text": value})
        if kind == "reasoning":
            self._reasoning_open = True

    def apply_delta(self, payload: dict) -> None:
        choice = next(iter(payload.get("choices") or []), {})
        self.finish_reason = choice.get("finish_reason") or self.finish_reason
        delta = choice.get("delta") or {}

        usage = payload.get("usage")
        if usage is not None:
            self.usage.append(usage)
            self.cached_tokens = (usage.get("prompt_tokens_details") or {}).get("cached_tokens") or 0

        think = next((delta[f] for f in self.think_fields if delta.get(f)), "")
        if think:
            self._append_text("reasoning", think)

        signature = delta.get("signature")
        if signature:
            for block in reversed(self.blocks):
                if block.get("type") == "reasoning":
                    block["signature"] = (block.get("signature") or "") + signature
                    break
            self._reasoning_open = False

        encrypted = delta.get("encrypted_content")
        if encrypted:
            for block in reversed(self.blocks):
                if block.get("type") == "reasoning":
                    block["encrypted_content"] = encrypted
                    break
            self._reasoning_open = False

        content = delta.get("content")
        if content:
            self._append_text("text", content)

        for tc in delta.get("tool_calls") or []:
            index = tc.get("index", 0)
            block = self._calls.get(index)
            if block is None:
                block = {"type": "tool_call", "id": None, "name": None, "arguments": ""}
                self.blocks.append(block)
                self._calls[index] = block
            if tc.get("id"):
                block["id"] = tc["id"]
            fn = tc.get("function") or {}
            if fn.get("name"):
                block["name"] = fn["name"]
            block["arguments"] += fn.get("arguments") or ""


