def print_command_help(world: World, cmd: str) -> None:
    """Write `wisp CMD --help` to stdout and exit 0."""
    world.get("stdout").write(command_help_text(cmd))
    raise SystemExit(0)


def unknown_sub(world: World, parent: str, sub: str) -> None:
    """An unknown nested command: the error line on stderr, the parent
    command's help on stdout, exit 1."""
    world.get("stderr").write("wisp: unknown command: %s\n" % sub)
    world.get("stdout").write(command_help_text(parent))
    raise SystemExit(1)


def no_such_command(world: World, cmd: str) -> None:
    """An unknown top-level command: the error line on stderr, the
    module docstring on stdout, exit 1. The single path to this
    state: parse_args validates argv[0] first, so main never sees
    an unvalidated command."""
    world.get("stderr").write("wisp: unknown command: %s\n" % cmd)
    world.get("stdout").write(__doc__)
    raise SystemExit(1)


# --- filesystem IO ----------------------------------------------------------------

class Fs:
    """All of wisp's file IO, one service on the standard library."""
    def __init__(self, world: World):
        self._world = world


    def mkdir(self, path: str) -> None:
        os.makedirs(path, exist_ok=True)

    def write_text(self, path: str, text: str) -> None:
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(text)

    def replace_text(self, path: str, text: str) -> None:
        """Replace a file's whole content atomically: write a sibling
        temp file, then os.replace it over the path. A kill mid-
        replace leaves either the old or the new content, never a mix
        of both."""
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.replace(tmp, path)

    def append_text(self, path: str, text: str) -> None:
        with open(path, "a", encoding="utf-8") as handle:
            handle.write(text)

    def read_text(self, path: str) -> str:
        with open(path, encoding="utf-8") as handle:
            return handle.read()

    def read_bytes(self, path: str) -> bytes:
        """The file bytes; one binary read for attachments."""
        with open(path, "rb") as handle:
            return handle.read()

    def exists(self, path: str) -> bool:
        return os.path.exists(path)

    def listdir(self, path: str) -> list:
        """The directory entries in os.listdir order; OSError passes to
        the caller."""
        return os.listdir(path)

    def isfile(self, path: str) -> bool:
        return os.path.isfile(path)

    def isdir(self, path: str) -> bool:
        return os.path.isdir(path)

    def realpath(self, path: str) -> str:
        return os.path.realpath(path)

    def cwd(self) -> str:
        return os.getcwd()

    def size(self, path: str) -> int:
        return os.path.getsize(path)

    def mtime(self, path: str) -> float:
        """The file's modification time, epoch seconds."""
        return os.path.getmtime(path)

    def symlink(self, target: str, path: str) -> None:
        os.symlink(target, path)

    def islink(self, path: str) -> bool:
        return os.path.islink(path)

    def readlink(self, path: str) -> str:
        return os.readlink(path)

    def remove(self, path: str) -> None:
        os.remove(path)

    def rename(self, src: str, dst: str) -> None:
        os.rename(src, dst)

    def last_byte(self, path: str) -> int | None:
        """The file's last byte, or None when the file is missing or empty."""
        size = os.path.getsize(path)
        if not size:
            return None
        with open(path, "rb") as handle:
            handle.seek(size - 1)
            return handle.read(1)[0]

    def read_head(self, path: str, limit: int) -> bytes:
        """At most the first limit bytes of a file."""
        with open(path, "rb") as handle:
            return handle.read(limit)


class Clock:
    """Wall time in UTC milliseconds and monotonic seconds."""
    def __init__(self, world: World):
        self._world = world


    def ms(self) -> int:
        return int(time.time() * 1000)

    def epoch(self) -> int:
        return int(time.time())

    def monotonic(self) -> float:
        return time.monotonic()


class Rng:
    """Random tokens: session names and spill file names."""
    def __init__(self, world: World):
        self._world = world


    def token(self, size: int = 8) -> str:
        alphabet = string.ascii_lowercase + string.digits
