# --- world ------------------------------------------------------------------
# All IO goes through the world, never direct, so a test world can swap
# the IO services freely.

class World:
    def __init__(self, registry: dict[str, Callable[[World], Any]]):
        self._registry = dict(registry)
        self._cache: dict[str, Any] = {}

    def get(self, name: str) -> Any:
        if name in self._cache:
            return self._cache[name]
        if name not in self._registry:
            raise KeyError(name)
        self._cache[name] = self._registry[name](self)
        return self._cache[name]

    def set(self, name: str, value: Any) -> None:
        """Set a run-scoped value, bypassing lazy instantiation."""
        self._cache[name] = value


# --- minimal IO that every layer needs ---------------------------------------

class Stdio:
    """Writer for one text stream. stdout and stderr share the class."""

    def __init__(self, stream: Any):
        self._stream = stream

    def write(self, text: str) -> None:
        self._stream.write(text)
        self._stream.flush()


class StdinFile:
    """stdin through the world: whole text, live lines, or the tty check."""

    def __init__(self, stream: Any):
        self._stream = stream

    def read_text(self) -> str:
        return self._stream.read()

    def lines(self) -> Iterator[str]:
        for line in self._stream:
            yield line.rstrip("\n")

    def is_interactive(self) -> bool:
        return self._stream.isatty()


def fail(world: World, message: str) -> None:
    """Print one stderr error line and exit 1."""
    world.get("stderr").write("wisp: %s\n" % message)
    raise SystemExit(1)


SECRET_QUERY_WORDS = ("key", "token", "secret")
"""Query-pair name fragments whose value safe_log hides."""

QUERY_PAIR_PATTERN = re.compile(r"([?&])([^=&\s]+)=([^&\s]*)")


def redact_query_of(text: str) -> str:
    """Hide the value of every query pair whose name names a secret.

    A provider puts the key in the URL as often as in a header, so a
    logged URL would leak it. The name test is a case-insensitive
    substring, because vendors spell one idea api-key, apiKey and
    x-goog-api-key. Nothing outside a query pair changes."""
    def replace(match: Any) -> str:
        name = match.group(2)
        if any(word in name.lower() for word in SECRET_QUERY_WORDS):
            return "%s%s=<redacted>" % (match.group(1), name)
        return match.group(0)
    return QUERY_PAIR_PATTERN.sub(replace, text)


def safe_log(world: World, event: str, *fields: str) -> None:
    """One wisp.log line through the session service; never raises.

    A failure that lands before the session dir is set drops the
    line, so observability cannot turn one clean failure into a
    second one. Every event that runs outside the normal turn flow
    - process exit, crashes, HTTP errors - logs through this. Every
    field passes redact_query_of first, so a URL-borne key never
    reaches wisp.log."""
    try:
        world.get("session").log(
            event, *(redact_query_of(str(field)) for field in fields))
    except (KeyError, AttributeError, TypeError, OSError):
        pass


