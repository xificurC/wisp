# --- command handlers ---------------------------------------------------------

def new_session(world: World, opts: Any) -> int:
    """Create the session dir under the sessions root: the --name, else a
    rand8. Capture the run setup on disk: model and thinking into
    wisp.run.json, the system record as the first wisp.jsonl entry when
    -s is given. Fails on an existing session dir. Prints the full path.
    With --parent DIR, the validated real parent path lands in the
    child's wisp.run.json through the setup write, and the child id
    lands in the parent's children list through link_child."""
    name = opts.name or world.get("rng").token(8)
    path = os.path.join(sessions_root(world), name)
    if world.get("fs").exists(path):
        fail(world, "session dir already exists: %s" % path)
    parent_path = (validate_parent_dir(world, opts.parent)
                   if opts.parent else None)
    world.get("fs").mkdir(path)
    register_sessions_root(world, sessions_root(world))
    session = world.get("session")
    session.write_run_setup(path, opts.model, opts.thinking,
                            parent=parent_path)
    system_text = None
    if opts.sysfile:
        system_text = world.get("fs").read_text(opts.sysfile)
        if opts.env_in_system_prompt:
            system_text = (environment_block(
                session_dir=os.path.abspath(path),
                sessions_root=os.path.abspath(sessions_root(world)),
                project_dir=git_root(world) or world.get("fs").cwd(),
                created=datetime.now().astimezone().isoformat(
                    timespec="seconds"),
                model=opts.model, thinking=opts.thinking or "")
                + "\n\n" + system_text)
    session.write_initial_log(path, system_text)
    if parent_path:
        link_child(world, parent_path, name)
    world.get("stdout").write(path + "\n")
    return 0


def validate_parent_dir(world: World, raw: str) -> str:
    """Validate one --parent session dir and return its real path.

    The dir must exist and hold wisp.jsonl and wisp.run.json; each
    missing piece fails with one stderr line, before any dir is
    made. Existence only: a parent with a broken wisp.run.json
    passes here and link_child warns best-effort. Returns
    fs.realpath(raw).
    """
    fs = world.get("fs")
    if not fs.isdir(raw):
        fail(world, "wisp new: --parent is not a session dir: %s" % raw)
    if not fs.exists(os.path.join(raw, "wisp.jsonl")):
        fail(world, "wisp new: --parent session dir has no wisp.jsonl: %s" % raw)
    if not fs.exists(os.path.join(raw, "wisp.run.json")):
        fail(world, "wisp new: --parent session dir has no wisp.run.json: %s" % raw)
    return fs.realpath(raw)


def link_child(world: World, parent_path: str, child_id: str) -> None:
    """Append one child id to the parent's children list.

    Reads <parent_path>/wisp.run.json, appends child_id to children
    (created when absent, skipped when already present), preserves
    every other key, writes one sorted JSON line. Best-effort: any
    failure warns on one stderr line and returns; the exit code never
    changes. The race guard compares the file mtime between read and
    write; a change warns that a parallel child link may be lost,
    and the write still lands, last-writer-wins.
    """
    fs = world.get("fs")
    stderr = world.get("stderr")
    path = parent_path + "/wisp.run.json"
    try:
        before = fs.mtime(path)
        text = fs.read_text(path)
    except OSError:
        stderr.write("wisp: warning: cannot link child %s under %s: "
                     "no readable wisp.run.json\n" % (child_id, parent_path))
        return
    try:
        setup = json.loads(text)
    except ValueError:
        stderr.write("wisp: warning: cannot link child %s under %s: "
                     "wisp.run.json is not JSON\n" % (child_id, parent_path))
        return
    if not isinstance(setup, dict):
        stderr.write("wisp: warning: cannot link child %s under %s: "
                     "wisp.run.json is not an object\n" % (child_id, parent_path))
        return
    children = setup.get("children")
    if children is None:
        children = []
    if not isinstance(children, list):
        stderr.write("wisp: warning: cannot link child %s under %s: "
                     "children is not a list\n" % (child_id, parent_path))
        return
    if child_id in children:
        return
    children.append(child_id)
    setup["children"] = children
    try:
        if fs.mtime(path) != before:
            stderr.write("wisp: warning: parent wisp.run.json changed during "
                         "the update; a parallel child link may be lost: %s\n"
                         % path)
        fs.write_text(path, json.dumps(setup, sort_keys=True) + "\n")
    except OSError:
        stderr.write("wisp: warning: cannot update children of %s\n"
                     % parent_path)
        return


def sessions_root(world: World) -> str:
    """The session folder root: WISP_SESSIONS_ROOT verbatim when set,
    else <project-root>/wisp-sessions/ (project root = git root, else
    the current directory)."""
    root = world.get("env").get("WISP_SESSIONS_ROOT")
    if root:
        return os.path.expanduser(root)
    return os.path.join(git_root(world) or world.get("fs").cwd(), "wisp-sessions")


def state_root(world: World) -> str:
    """The registry root: WISP_STATE_ROOT when set, else
    <XDG_STATE_HOME> or <HOME>/.local/state, plus /wisp-sessions."""
    env = world.get("env")
    override = env.get("WISP_STATE_ROOT")
    if override:
        return os.path.expanduser(override)
    base = (env.get("XDG_STATE_HOME")
            or os.path.join(home_dir(env), ".local", "state"))
    return os.path.join(os.path.expanduser(base), "wisp-sessions")


def registry_link_name(root: str) -> str:
    """The link name: the root with every / as __, cut to the last
    255 bytes when too long."""
    data = root.replace("/", "__").encode("utf-8")
    if len(data) > 255:
        data = data[-255:]
    return data.decode("utf-8", errors="ignore")


def register_sessions_root(world: World, root: str) -> None:
    """One link per project under the state root: the link name is the
    real path of the sessions root encoded by registry_link_name, the
    target is the real path. Best-effort, like link_child: any failure
    warns on one stderr line and returns; the exit code never changes
    and wisp new still prints the session dir. Idempotent: a link with the
    same target stays; a different target, a plain file, or a dangling
    link is removed and the link recreated. wisp never deletes a
    registry link except in that repair."""
    fs = world.get("fs")
    try:
        state = state_root(world)
        fs.mkdir(state)
        real = fs.realpath(root)
        link = os.path.join(state, registry_link_name(real))
        if fs.islink(link) and fs.readlink(link) == real:
            return
        if fs.islink(link) or fs.exists(link):
            fs.remove(link)
        fs.symlink(real, link)
    except OSError as exc:
        world.get("stderr").write("wisp: warning: registry: %s\n" % exc)


def skill_command(world: World, opts: Any) -> int:
    """Dispatch `skill ls` and `skill read SKILL`."""
    out = world.get("stdout")
    if opts.sub == "ls":
        for name, desc, path in collect_skills(world):
            out.write("%s: %s (%s)\n" % (name, desc, path))
        return 0
    if opts.sub == "read":
        path = resolve_skill_path(world, opts.skill)
        if not path:
            fail(world, "skill not found: %s" % opts.skill)
        out.write(skill_block(world, opts.skill, path) + "\n")
        return 0
    fail(world, "wisp skill: use ls, or read SKILL")


def xml_block(tag: str, src: str | None, text: str) -> str:
    """One prompt part in an XML block; src names the file when the
    part is read from one."""
    head = "<%s%s>" % (tag, ' src="%s"' % src if src else "")
    return "%s\n%s\n</%s>" % (head, text, tag)


def agents_md_command(world: World, opts: Any) -> int:
    """Dispatch `agents-md ls` and `agents-md read-all`."""
    docs = agents_md_files(world)
    out = world.get("stdout")
    if opts.sub == "ls":
        for path in docs:
            out.write(path + "\n")
        return 0
    if opts.sub == "read-all":
        out.write("\n\n".join(
            xml_block("agents-md", p, world.get("fs").read_text(p)) for p in docs
        ) + "\n" if docs else "")
        return 0
    fail(world, "wisp agents-md: use ls or read-all")


ENVIRONMENT_LINES_TEMPLATE = """\
SESSION DIR: {session_dir}
SESSIONS ROOT: {sessions_root}
PROJECT DIR: {project_dir}
SESSION CREATION TIME: {created}
MODEL: {model}
THINKING: {thinking}"""


def environment_block(session_dir: str, sessions_root: str, project_dir: str,
                      created: str, model: str = "",
                      thinking: str = "") -> str:
    """The environment for one new run in one XML block, built fresh on
    each call from the values computed at new time. The tag names the
    block; the lines carry hard values only. MODEL is required at new
    time, so its line always lands. THINKING lands only when the run
    sets it; a run on the default thinking set drops the line."""
    lines = ENVIRONMENT_LINES_TEMPLATE.format(
        session_dir=session_dir, sessions_root=sessions_root,
        project_dir=project_dir, created=created,
        model=model, thinking=thinking).split("\n")
    if not thinking:
        lines = [line for line in lines if not line.startswith("THINKING:")]
    return xml_block("environment", None, "\n".join(lines))


def skills_preamble() -> str:
    """The preamble that opens the <skills> block."""
    return """\
These are the available skills. When the user request fits a skill's
description, read the skill file first and follow it."""


def wisp_block() -> str:
    """The wisp block: harness contract, session dir file map, turn model,
    subagents recipe. Built fresh on each call. <sessiondir> stays
    literal; build-system-prompt learns no session dir, the reader
    maps it to the SESSION DIR line of the ENVIRONMENT block that
    wisp new writes at creation time."""
    return """\
HARNESS

You have three tools: bash, python3, and load_image.
Each bash or python3 call takes three arguments: command, timeoutSeconds, maxKilobytes.
The defaults are 5 seconds and 5 kilobytes.
A timeout stops the command and returns exit code 124.
Set maxKilobytes higher when you need more output in one call.
Set timeoutSeconds higher when you need more time in one call.
The pattern for slow work: one foreground call with a raised
timeoutSeconds. The call waits, then returns the result.
The anti-pattern: start the command with nohup or & in one call, then
poll for its end with sleep loops in later calls. Do not do this.
Each poll round only waits and adds cost. Keep the command in the
foreground of one call and raise its timeoutSeconds instead.

Every tool result starts with one line of harness status, then the
command's output. The line begins "wisp:tool ". That line is not
output. Fields: name, exit, ms, and, only when they apply, bytes,
offset, rest_kb, spill, timeout_s, abandoned. exit is the process
exit code; nonzero is a fact, not a verdict (grep and diff use 1).
A result with spill="..." was truncated at the returned head. Read the
rest with: tail -c +<offset> <spill-path>. Set maxKilobytes=rest_kb on
a new call to read the rest in one piece. Spill files are never deleted.
The first byte after the status line is the command's first byte.

SESSION DIR

The session dir is the directory of this one wisp session. It is
not the current directory. Your tool commands start in the project directory.
The session dir holds: wisp.jsonl, spill/, wisp.log, wisp.usage,
wisp.modelcfg, wisp.run.json, and wisp.stream when a caller
redirected the run stream there.
wisp.jsonl is the record of truth for the session.
wisp appends one commit to wisp.jsonl when a run exits.
Do not edit wisp.jsonl by hand.
wisp owns spill/. Do not write there.
wisp.log holds the run log.
wisp.usage holds the cumulative usage chunks.
wisp.run.json holds the model and thinking settings.
When an <environment> block opens your system prompt, its MODEL and
THINKING lines hold the same settings. A missing THINKING line
means the run sets no thinking; omit -t. Do not read wisp.run.json
for them.
wisp.modelcfg holds model entries with context size and cost data.

TURN MODEL

One wisp run reads one prompt from stdin and sends it to the model.
wisp run prints raw "data:" SSE lines. Do not parse those lines.
After a run, read state with these commands only:
"render-past -d DIR" shows the session as formatted text.
"response -d DIR" shows the final assistant message as plain text.
"usage -d DIR" shows cost and token data for the run.
Each tool call gets a {"wisp":"tool_call",...} data: line before wisp
runs the call. The tool note follows the result. Read both before you
decide.
load_image takes a path and an optional resize flag. The default
resize true fits the image into the default dimension and byte
limits. resize false sends the file bytes unchanged.
""" + "\n\n" + subagents_block()


def subagents_block() -> str:
    """The SUBAGENTS section of the wisp block: the delivery guard,
    the laws, the recipes with -d, the no-export law, the
    variations, and the open-endedness statement. Pure text, no world
    input.
    """
    return """\
SUBAGENTS

This block carries the subagent laws. A session with no SUBAGENTS
block in its system prompt must not start children. It must ask
the operator to rebuild its prompt with --wisp.

LAWS

The parent law: give every child --parent with your session dir. A
child without --parent is an orphan. "wisp ls --tree" and
"wisp grep --tree" cannot see an orphan.

The stream law: send child stdout to "$CHILD/wisp.stream".
"wisp render-live" follows this exact path. A stream at any other
path breaks that tool. The stream never goes into your tool
result. Read the answer with "wisp response". Delete the stream
after the read. The stream is temporary data. wisp.jsonl is the
record of truth.

The home rule: put every child artifact in the child session dir.
These artifacts are the prompt file, the stream, and captured
response text. Do not use /tmp.

The symbol map: in the parent recipe, $CHILD names the child run
dir. In the child session itself, WISP_SESSION_DIR names that same
dir.

A subagent is a child wisp session. You start it from the bash
tool. The primary recipe:

  CHILD="$(wisp new --name NAME -m MODEL --parent <session dir>)"
  wisp run -d "$CHILD" --context-guard 70% > "$CHILD/wisp.stream" <<'EOF'
  <the child's prompt>
  EOF
  wisp response -d "$CHILD"
  rm "$CHILD/wisp.stream"

A live view, in another terminal:
  tail -f "$CHILD/wisp.stream" | wisp render-live
A past view stays available through "wisp render-past -d <child>"
after the run. The prompt-file recipe, the escape from heredoc
quoting:

  CHILD="$(wisp new --name NAME -m MODEL --parent <session dir>)"
  cat > "$CHILD/prompt.txt" <<'EOF'
  <the child's prompt>
  EOF
  wisp run -d "$CHILD" --context-guard 70% < "$CHILD/prompt.txt" > "$CHILD/wisp.stream"
  wisp response -d "$CHILD"
  rm "$CHILD/wisp.stream"

The persona recipe, a child that runs one skill as its system
prompt:

  CHILD="$(wisp new --name NAME -m MODEL -t THINKING
           --parent <session dir>
           --env-in-system-prompt
           -s <(wisp build-system-prompt --wisp --skills --agents-md
                < <(wisp skill read SKILL)))"
  wisp run -d "$CHILD" --context-guard 70% > "$CHILD/wisp.stream" <<'EOF'
  <the child's prompt>
  EOF
  wisp response -d "$CHILD"
  rm "$CHILD/wisp.stream"

"wisp skill read SKILL" prints the skill body, frontmatter
stripped, in a <skill> block. Feed it to "wisp build-system-prompt"
on stdin. "wisp build-system-prompt --wisp --skills --agents-md"
assembles the wisp block, the AGENTS.md chain, the skills catalog,
and stdin into the persona file. The -s argument is a file path,
never the persona content. Use the process substitution form as
shown. "--env-in-system-prompt" prepends
the child's own <environment> block, so the child learns its run
dir, its MODEL, and its THINKING. Use it on every persona child.
By default, give the child your own MODEL and THINKING, unless the
user provides them. 70% is the default guard limit; change it when
the task needs it.

A child run that the guard stops exits with code 75. Its finished
rounds stay committed. A guard stop lands after a tool round, so
most times the last record is not an answer and wisp response shows
nothing. Read the end of the child session with wisp render-past
-d <child dir> | tail -n <n>. Two options continue the child:
- Raise the limit: wisp continue -d <child dir> --context-guard
  LIMIT, with a limit higher than before.
- Summarize the session by hand and start a new run with the
  summary text as the prompt. Wisp ships no summarizing prompt, so
  use one of your own: wisp run -d <child dir> < summary.md.

The no-export law: the recipes never export WISP_SESSION_DIR. Every call
names its session dir with -d. An export dies with the shell process; a
later bare wisp command then binds to the parent's own WISP_SESSION_DIR
and runs the parent's session.

The parent session dir comes from the SESSION DIR line of the environment
block. wisp new prints the child session dir path; the shell variable
carries it to the -d argument of wisp run and wisp response. A child
may take a persona file with -s SYSFILE. Read the cost with
"wisp usage". Run several children in parallel: start each run
with & and end the same call with wait. Raise timeoutSeconds for
that call. Give each child run --context-guard, so a child that
overruns its context stops itself. Name children with --name for
later retrieval.
"wisp ls --tree" and "wisp grep --tree" cover one session subtree
through the children references.

The invariants:
- --parent on every "wisp new" for a child.
- -d on every call.
- Child stdout to "$CHILD/wisp.stream".
- "wisp response -d" for the answer.
- Delete the stream after the read.
- Child artifacts in the child session dir.
- Never export WISP_SESSION_DIR.

The recipe is open-ended. The shape is open; the invariants are not.
Keep all invariants in each variant of the recipe. You decide the
shape: one child or many, sequential or parallel, prompted inline
or from a file. Nesting depth is unlimited by wisp. wisp spawns
nothing on its own."""


def build_system_prompt(world: World, opts: Any) -> int:
    """Concatenate the wisp block, AGENTS.md files, skill summaries,
    and stdin."""
    if not (opts.wisp or opts.agents_md or opts.skills):
        fail(world, "wisp build-system-prompt: pass --agents-md or --skills")
    blocks = []
    if opts.wisp:
        blocks.append(xml_block("wisp", None, wisp_block()))
    if opts.agents_md:
        blocks.extend(
            xml_block("agents-md", p, world.get("fs").read_text(p))
            for p in agents_md_files(world)
        )
    if opts.skills:
        blocks.append(xml_block("skills", None, "%s\n\n%s" % (
            skills_preamble(), "\n".join(
                "%s: %s (%s)" % (n, d, p)
                for n, d, p in collect_skills(world)))))
    inline = ""
    if not world.get("stdin").is_interactive():
        inline = world.get("stdin").read_text()
    if inline.strip():
        blocks.append(xml_block("stdin", None, inline))
    if not blocks:
        return 0
    world.get("stdout").write("\n\n".join(blocks) + "\n")
    return 0


class SignalExit(BaseException):
    """Graceful shutdown: SIGTERM or SIGHUP reached `wisp run`.

    The handler raises this so the interpreter unwinds the run loop;
    the exit commit in the finally block flushes what the run holds to
    wisp.jsonl. BaseException, like KeyboardInterrupt and SystemExit,
    keeps broad `except Exception` handlers - the model-info fetch,
    tool runs - from swallowing it. main turns it into exit code
    128 + signum, the shell convention."""

    def __init__(self, signum: int):
        super().__init__(signum)
        self.signum = signum


class ContextGuardExit(Exception):
    """The context guard fired: context use crossed the limit.

    loop_rounds raises it at a round boundary, after the round
    committed. run_prepared catches it, writes the stop line, and
    exits GUARD_EXIT through the normal flush path, so every
    finished round stays on disk and the session stays resumable.
    An Exception, not a BaseException: only run_prepared must catch
    it, and main's crash handler must never see it."""

    def __init__(self, round_no: int, used: int, guard: dict):
        super().__init__("round %s used %s tokens"
                         % (round_no, used))
        self.round_no = round_no
        self.used = used
        self.guard = guard


def install_exit_signals(world: World) -> None:
    """Turn SIGTERM and SIGHUP into SignalExit raises for `wisp run`.

    The raise unwinds through the run loop's finally block, so the
    exit commit flushes every completed round; a kill then loses at
    most the in-flight round. SIGINT keeps its default
    KeyboardInterrupt path, which unwinds the same way and exits 130.
    Install fails silently off the main thread or on a platform
    without the signal; the default kill behavior then applies."""

    def raise_exit(signum: int, frame: Any) -> None:
        raise SignalExit(signum)

    for sig in (signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(sig, raise_exit)
        except (ValueError, OSError):
            pass


def check_request_of(world: World) -> None:
    """The start checks every run and continue share.

    A full URL with a scheme and a path, a known request shape, and a
    resolvable header table. The key check lives in auth_headers_of,
    so a no-auth endpoint needs no key, and a missing key fails here
    before the prompt is read instead of after the run commits it."""
    request_url_of(world)
    provider_of(world)
    auth_headers_of(world)


def load_session_state(world: World, opts: Any) -> tuple:
    """Bind the session dir, load its setup and its committed records.

    Shared by run and continue: model and thinking come from
    wisp.run.json, the records and the commit point from
    wisp.jsonl. The commit point lands in world, where every commit
    advances it, so a record writes exactly once whatever exit path
    runs."""
    world.set("sessiondir", opts.sessiondir)
    setup = world.get("session").load_run_setup(opts.sessiondir)
    world.set("model", setup["model"])
    world.set("thinking", setup.get("thinking"))
    check_request_of(world)
    records, committed = world.get("session").load_events()
    world.set("committed", committed)
    return setup, records


def run_prepared(world: World, records: list, setup: dict) -> int:
    """Run the round loop on a prepared conversation, flush at exit.

    The shared core of `wisp run` and `wisp continue`: install the
    exit signals, run loop_rounds with the segment's restored round
    counter, and let the exit commit flush whatever no round
    committed. SIGTERM and SIGHUP raise SignalExit; the unwinding
    reaches the exit commit, which flushes the same tail, and main
    exits 128 + signum. A context guard that fired at a round
    boundary returns GUARD_EXIT through the same exit commit. After
    the flush, warn_undelivered_steer warns
    when the steer inbox still holds messages the run never injected."""
    install_exit_signals(world)
    safe_log(world, "run", "start", "pid=%s" % os.getpid(),
             "model=%s" % world.get("model"),
             "api=%s" % (world.get("env").get("WISP_LLM_API") or "openai-chat"))
    try:
        world.get("session").refresh_model_cfg()
        try:
            loop_rounds(world, records, max_rounds_of(world),
                        world.get("context_guard"))
            return 0
        except ContextGuardExit as exc:
            guard_stop_line(world, exc)
            return GUARD_EXIT
    finally:
        flush_records(world, records)
        warn_undelivered_steer(world)


def run_agent_loop(world: World, opts: Any) -> int:
    """`wisp run`: read the prompt from stdin and run the rounds.

    The prompt becomes the user record that opens the turn's segment.
    Each completed round commits to wisp.jsonl when its tail is a
    stable boundary: a kill loses at most the current round; the
    discard rule in load_events covers the tail it leaves. MAX_TURNS
    exhaustion leaves the in-progress segment raw on disk. A steer
    inbox an earlier run left behind drains
    first - steer_intake - so its messages join the conversation as
    steered user records before the new prompt."""
    setup, records = load_session_state(world, opts)
    world.set("context_guard",
              context_guard_of(world, getattr(opts, "context_guard", None)))
    steer_intake(world, records)
    prompt = world.get("stdin").read_text()
    if not prompt.strip():
        fail(world, "no user prompt on stdin")
    user_rec = {"type": "user", "content": prompt}
    attachments = load_attachments(world, getattr(opts, "attach", None))
    if attachments:
        user_rec["attachments"] = attachments
    records.append(user_rec)
    return run_prepared(world, records, setup)


def continue_agent_loop(world: World, opts: Any) -> int:
    """`wisp continue`: finish an open segment without a new prompt.

    Never appends a user prompt - `wisp run` owns that behavior - so
    the killed segment's records stay in the conversation as plain
    history. The tail of wisp.jsonl decides. An open tail - a user
    prompt or tool records - runs the loop directly on the loaded
    conversation. A stop-finish assistant tail - a finished plain
    run - and an empty log fail fast and name `wisp run`. Reads no
    stdin."""
    setup, records = load_session_state(world, opts)
    world.set("context_guard",
              context_guard_of(world, getattr(opts, "context_guard", None)))
    if not records or records[-1].get("type") == "system":
        fail(world, "wisp continue: nothing to continue in %s"
                    % opts.sessiondir)
    tail = records[-1]
    if tail.get("type") == "assistant" and not any(
            block.get("type") == "tool_call"
            for block in tail.get("output") or []):
        fail(world, "wisp continue: the run finished;"
                    " use `wisp run` with a prompt")
    elif tail.get("type") not in ("user", "tool"):
        fail(world, "wisp continue: nothing to continue in %s"
                    % opts.sessiondir)
    return run_prepared(world, records, setup)


def steer_command(world: World, opts: Any) -> int:
    """`wisp steer`: queue one steering message for the session's runs.

    The message - the whole stdin text, its trailing newline off -
    lands as one JSON line in <DIR>/wisp.steer.inbox, appended when
    the file holds earlier messages, so messages stack in order. A
    live `wisp run` drains the inbox at each round boundary and turns
    each line into one steered user record; a run that ends with
    messages still waiting warns on stderr, and the next `wisp run`
    injects them before its prompt. No lock, no liveness check: the
    inbox write is the whole command, so it works on any session dir
    and never disturbs a running loop."""
    world.set("sessiondir", opts.sessiondir)
    message = world.get("stdin").read_text()
    if not message.strip():
        fail(world, "no steer message on stdin")
    fs = world.get("fs")
    inbox = opts.sessiondir + "/" + STEER_INBOX
    fs.append_text(inbox, json.dumps(
        {"content": message.rstrip("\n")}, ensure_ascii=False) + "\n")
    world.get("session").log("steer", "queued=1")
    return 0


def max_rounds_of(world: World) -> int:
    """The loop's round cap: WISP_LLM_MAX_TURNS, else DEFAULT_MAX_TURNS."""
    raw = world.get("env").get("WISP_LLM_MAX_TURNS", str(DEFAULT_MAX_TURNS))
    try:
        return int(raw)
    except ValueError:
        fail(world, "WISP_LLM_MAX_TURNS is not a number: %s" % raw)


def steer_intake(world: World, records: list) -> int:
    """Drain the steer inbox at one round boundary; the count of
    steered records appended.

    One atomic rename - wisp.steer.inbox to a consumed name - takes
    the whole mailbox, then the consumed copy is read: a `wisp steer`
    append that lands after the rename starts a fresh inbox, so no
    message is lost and none is read twice. Each complete JSON line
    becomes one steered user record, marked wisp_steered: a plain user
    record on the wire that never opens a segment and never resets
    the round counter. A line that fails json.loads is a mid-append
    kill remnant; it is skipped, not injected. The records commit
    before the loop runs on - flush_records - so a kill after the
    drain loses nothing: the steered record is on disk and a later
    `wisp continue` resumes it. Each injection writes one
    `data: {"wisp":"steer",...}` stream line, so a live `wisp render-live`
    shows the steering; one steer line lands in wisp.log."""
    fs = world.get("fs")
    inbox = world.get("sessiondir") + "/" + STEER_INBOX
    if not fs.exists(inbox):
        return 0
    consumed = "%s.%s" % (inbox, world.get("rng").token(8))
    try:
        fs.rename(inbox, consumed)
    except OSError:
        return 0
    try:
        text = fs.read_text(consumed)
    except OSError:
        text = ""
    count = 0
    for line in text.split("\n"):
        if not line.strip():
            continue
        try:
            message = json.loads(line)
        except ValueError:
            continue
        content = (message.get("content")
                   if isinstance(message, dict) else None)
        if not isinstance(content, str) or not content.strip():
            continue
        records.append({"type": "user", "content": content,
                        "wisp_steered": True})
        world.get("stdout").write("data: %s\n" % json.dumps(
            {"wisp": "steer", "content": content}, ensure_ascii=False))
        count += 1
    fs.remove(consumed)
    if count:
        flush_records(world, records)
        world.get("session").log("steer", "injected=%s" % count)
    return count


def warn_undelivered_steer(world: World) -> None:
    """Warn when the run ended with steer messages still waiting.

    The mandatory end-of-run warning: messages that queued after the
    last round boundary never reached the model. Counts the complete
    JSON lines in the inbox and warns once on stderr with the count
    and the inbox path. The inbox stays in place - the next `wisp run`
    drains it before its prompt, so no message is lost."""
    fs = world.get("fs")
    inbox = world.get("sessiondir") + "/" + STEER_INBOX
    if not fs.exists(inbox):
        return
    try:
        text = fs.read_text(inbox)
    except OSError:
        return
    count = 0
    for line in text.split("\n"):
        if not line.strip():
            continue
        try:
            message = json.loads(line)
        except ValueError:
            continue
        if (isinstance(message, dict)
                and isinstance(message.get("content"), str)
                and message["content"].strip()):
            count += 1
    if count:
        world.get("stderr").write(
            "wisp: warning: %s steer message(s) never injected; they"
            " wait in %s; the next `wisp run` injects them before"
            " its prompt\n" % (count, inbox))


def turn_has_content(result: dict) -> bool:
    """A turn can end the segment only when it holds a tool-call
    block or a text block with non-empty text.

    Reasoning alone does not count. A stop that carries only
    thinking is the model ending its turn with no answer: the
    kept-context format requires a text message, so accepting a
    reasoning-only stop commits an empty final record and the
    segment ends silently mid-work (verified 2026-10-07: four
    premature segment ends, wisp.jsonl record with
    finish=stop blocks=[])."""
    for block in result["assistant"].get("output") or []:
        kind = block.get("type")
        if kind == "tool_call":
            return True
        if kind == "text" and (block.get("text") or "").strip():
            return True
    return False


def turn_with_degenerate_guard(world: World, llm: Any, records: list,
                               round_no: int) -> dict:
    """One llm.turn guarded against a textless turn end.

    A turn ends only when its record carries a tool-call block or a
    text block with content: tool calls run their tools, text closes
    the turn. A result that ends with neither - a stop after
    thinking only, an empty completion whatever usage it carries, or
    an endpoint stream that carried no completion payload at all -
    is not a turn end: the record is appended when it holds blocks,
    so the thinking rides the next request and survives on disk, and
    the model is asked again. Every retry appends RETRY_NUDGE as a
    user record, so the next attempt is a new request and not a
    plain resend of the request that just came back empty. The guard
    allows at most WISP_DEGENERATE_RETRY such textless attempts
    (default DEGENERATE_ATTEMPTS) and then fails the run with one
    degenerate log line, so no empty final record reaches the jsonl.
    An empty-stream note from sse_stream rides the retry and
    degenerate log lines and the failure text. Each attempt logs
    its own request/response pair because every retry is a new
    request."""
    session = world.get("session")
    try:
        bound = max(1, int(world.get("env").get("WISP_DEGENERATE_RETRY")))
    except (TypeError, ValueError):
        bound = DEGENERATE_ATTEMPTS
    for attempt in range(bound):
        world.set("stream_note", "")
        session.log("request", "model=%s" % world.get("model"),
                    "api=%s" % (world.get("env").get("WISP_LLM_API")
                                or "openai-chat"),
                    "effort=%s" % (world.get("thinking") or "none"),
                    "round=%s" % round_no)
        result = llm.turn(records)
        note = world.get("stream_note") or ""
        session.log("response", "round=%s" % round_no,
                    "finish_reason=%s" % result["finish_reason"])
        session.log("cache", "round=%s" % round_no,
                    "cached_tokens=%s" % result["cached_tokens"])
        if result["finish_reason"] == "tool_calls" or turn_has_content(result):
            return result
        kinds = ",".join(block.get("type") or "?"
                         for block in result["assistant"].get("output")
                         or []) or "none"
        appended = False
        if result["assistant"].get("output"):
            # Not a turn end: the record stays. The thinking rides
            # the next request and survives on disk.
            records.append(result["assistant"])
            appended = True
        if attempt < bound - 1:
            records.append({"type": "user", "content": RETRY_NUDGE,
                            "wisp_retry": True})
            flush_records(world, records)
            fields = ["round=%s" % round_no,
                      "finish_reason=%s" % result["finish_reason"],
                      "blocks=%s" % kinds,
                      "usage_chunks=%s" % len(
                          result["assistant"].get("usage") or [])]
            if note:
                fields.append("note=%s" % note)
            session.log("retry", *fields)
            continue
        if appended:
            flush_records(world, records)
        fields = ["round=%s" % round_no,
                  "finish_reason=%s" % result["finish_reason"],
                  "blocks=%s" % kinds, "usage_chunks=0"]
        if note:
            fields.append("note=%s" % note)
        session.log("degenerate", *fields)
        cause = ("; %s" % note) if note else ""
        fail(world, "round %s ended with an empty or textless %s"
                    " response - no text and no tool calls -"
                    " after %s attempts (WISP_DEGENERATE_RETRY)%s;"
                    " the finished rounds stay on disk"
             % (round_no, result["finish_reason"] or "<none>", bound, cause))
    raise AssertionError("unreachable: the guard returns or fails")


# --- context guard ---------------------------------------------------------------

def parse_context_guard(world: World, raw: str) -> dict:
    """Parse one --context-guard value.

    '70%' is a percent of the model's context window, 1 to 99.
    '150k', '1m' and a plain number are token limits; k and m
    multiply by 1000 and 1000000. Returns the spec
    {"kind": "percent"|"tokens", "value": int}; every other form
    fails with one line that names the valid forms."""
    text = str(raw).strip()
    body, percent = text, False
    if body.endswith("%"):
        body, percent = body[:-1], True
    mult = 1
    if body and body[-1] in "kKmM":
        if percent:
            fail(world, "--context-guard %s: a percent takes no k or m"
                        " suffix" % text)
        mult = 1000 if body[-1] in "kK" else 1000000
        body = body[:-1]
    if not (body.isascii() and body.isdigit()):
        fail(world, "--context-guard %s: use a percent like 70%%, a"
                    " token count like 150k or 1m, or a plain token"
                    " number like 200000" % text)
    value = int(body) * mult
    if percent and not 1 <= value <= 99:
        fail(world, "--context-guard %s: the percent needs a value"
                    " from 1 to 99" % text)
    if not percent and value <= 0:
        fail(world, "--context-guard %s: the token limit needs a"
                    " positive number" % text)
    return {"kind": "percent" if percent else "tokens", "value": value}


def context_guard_of(world: World, raw) -> dict | None:
    """The resolved context guard for one run, None without the flag.

    Percent mode needs the model's context window from the session's
    wisp.modelcfg, so the guard fails at start - before the first
    round - when the entry or the window is missing: a guard the
    caller asked for must not turn itself off in silence, and the
    error names the token form that needs no modelcfg. Token mode
    needs no modelcfg and carries no window.

    A fresh session has no wisp.modelcfg until a run writes it, and
    the run writes it after this call, so percent mode copies the
    file itself first - the same best-effort WISP_LLM_MODEL_INFO_FILE
    read refresh_model_cfg makes - and fails only when the copy
    leaves no window either."""
    if raw is None:
        return None
    spec = parse_context_guard(world, raw)
    if spec["kind"] != "percent":
        return spec
    path = world.get("sessiondir") + "/wisp.modelcfg"
    cfg = read_model_cfg(world, path, world.get("model"))
    window = int(cfg.get("context") or 0) if cfg else 0
    if window <= 0:
        world.get("session").refresh_model_cfg()
        cfg = read_model_cfg(world, path, world.get("model"))
        window = int(cfg.get("context") or 0) if cfg else 0
    if window <= 0:
        fail(world, "--context-guard %s%%: no context window for model"
                    " %s in %s/wisp.modelcfg; use a token limit like"
                    " --context-guard 150k"
             % (spec["value"], world.get("model"),
                world.get("sessiondir")))
    spec["window"] = window
    return spec


def check_context_guard(world: World, records: list, round_no: int,
                        guard: dict | None) -> None:
    """Stop the run when context use crossed the guard limit.

    Runs at a round boundary: the round's records committed, the next
    llm.turn not yet sent. The measure is the prompt_tokens of the
    last assistant record - the size of the request that closed the
    round, so it lags one round behind the next request and holds
    none of the stopped round's tool results. A round that reports no
    usage skips the check. Raises ContextGuardExit; run_prepared
    turns it into exit GUARD_EXIT through the normal flush path."""
    if guard is None:
        return
    for rec in reversed(records):
        if rec.get("type") != "assistant":
            continue
        chunks = rec.get("usage") or []
        if not chunks:
            return
        chunk = chunks[-1]
        usage = (chunk.get("usage") if isinstance(chunk.get("usage"), dict)
                 else chunk)
        used = int(usage.get("prompt_tokens") or 0)
        if guard["kind"] == "percent":
            window = int(guard.get("window") or 0)
            if used * 100 >= guard["value"] * window:
                raise ContextGuardExit(round_no, used, guard)
        elif used >= guard["value"]:
            raise ContextGuardExit(round_no, used, guard)
        return


def guard_stop_line(world: World, exc: ContextGuardExit) -> None:
    """One stderr line and one wisp.log line for a guard stop.

    The line states the session dir, the round, the used tokens, the
    window and the percent when known, and the limit. It names the
    three next steps - run, steer, do nothing - because the harness
    stops and the caller chooses. Token mode reads the window
    best-effort for the line only; the stop never depends on it."""
    guard = exc.guard
    window = int(guard.get("window") or 0)
    if window <= 0:
        cfg = read_model_cfg(world,
                             world.get("sessiondir") + "/wisp.modelcfg",
                             world.get("model"))
        window = int(cfg.get("context") or 0) if cfg else 0
    if guard["kind"] == "percent":
        limit = "%s%% (%s tokens)" % (
            guard["value"],
            fmt_tokens(guard["value"] * window // 100))
    else:
        limit = "%s tokens" % fmt_tokens(guard["value"])
    context = ("used %s of %s tokens (%.1f%%)"
               % (fmt_tokens(exc.used), fmt_tokens(window),
                  exc.used * 100.0 / window)) if window > 0 else (
        "used %s tokens" % fmt_tokens(exc.used))
    world.get("stderr").write(
        "wisp: context guard: %s stopped at round %s: %s, limit %s;"
        " next: `wisp run` with a new prompt, `wisp steer` with a"
        " message, or do nothing\n"
        % (world.get("sessiondir"), exc.round_no, context, limit))
    safe_log(world, "guard", "round=%s" % exc.round_no,
             "used=%s" % exc.used, "window=%s" % window,
             "kind=%s" % guard["kind"], "value=%s" % guard["value"])


def loop_rounds(world: World, records: list, max_rounds: int,
                guard: dict | None = None) -> None:
    """The model round loop of `wisp run`.

    One loop step is one round: one llm.turn and, when the model ends
    with tool_calls, one tool execution. Each turn passes through
    turn_with_degenerate_guard, which keeps every textless result -
    thinking preserved, record appended, request re-sent - and fails
    the run after WISP_DEGENERATE_RETRY attempts with no text, so a
    broken endpoint stream can no longer end a run silently.
    Tool-call blocks decide the round, not the finish marker: a turn
    that holds tool calls runs its tools whatever the finish says,
    because some endpoints end a tool-bearing stream with stop or
    with no finish marker at all. A turn with no finish marker never
    ends the run: the loop keeps the round and asks again. The loop
    mutates records in place and commits each round whose tail is a
    stable boundary, every commit advances the shared commit point in
    world, so the exit commit at run exit appends only what no round
    committed. Each round opens with steer_intake: the steer inbox
    drains at the boundary the last round's flush left, so a queued
    steering message joins the conversation as a user record before
    the next llm.turn. A context guard, when the run carries one,
    checks each committed round boundary before the next llm.turn:
    check_context_guard raises ContextGuardExit when the last round's
    prompt tokens crossed the limit, and the unwind commits through
    run_prepared's exit commit and exits GUARD_EXIT. MAX_TURNS
    exhaustion leaves the in-progress segment raw on disk."""
    session, llm, tools = world.get("session"), world.get("llm"), world.get("tools")
    for round_no in range(1, max_rounds + 1):
        steer_intake(world, records)
        result = turn_with_degenerate_guard(
            world, llm, records, round_no)
        assistant = result["assistant"]
        records.append(assistant)
        calls = [b for b in assistant["output"] if b["type"] == "tool_call"]
        if calls:
            # Tool-call blocks decide the round, not the finish marker.
            # Some endpoints end the stream with stop, or with no
            # finish marker at all, while the model asked for tools.
            # The turn is not over: run the tools and keep going.
            records.extend(tools.execute(calls))
            flush_records(world, records)
            check_context_guard(world, records, round_no, guard)
            continue
        if result["finish_reason"] == "":
            # The stream carried no finish marker. This is not a turn
            # end. Keep the round on disk and ask again.
            flush_records(world, records)
            check_context_guard(world, records, round_no, guard)
            continue
        if result["finish_reason"] != "tool_calls":
            flush_records(world, records)
            return
        fail(world, "round %s finished with tool_calls but holds no"
                    " tool call block" % round_no)
    world.get("stderr").write(
        "wisp: warning: reached WISP_LLM_MAX_TURNS (%s); terminating\n" % max_rounds)


@contextlib.contextmanager
def commit_guard():
    """Hold SIGINT, SIGTERM and SIGHUP off for the commits inside.

    A signal that lands inside a commit stays pending until the block
    lifts and its raise lands after the commit-point move, so no
    signal splits a commit or makes a later commit write a batch that
    is on disk already. Off the main thread, or on a platform without
    the mask, the guard does nothing; the default kill behavior then
    applies."""
    try:
        signal.pthread_sigmask(signal.SIG_BLOCK,
                               {signal.SIGINT, signal.SIGTERM,
                                signal.SIGHUP})
        blocked = True
    except (AttributeError, OSError, ValueError):
        blocked = False  # no mask on this platform: commit unguarded
    try:
        yield
    finally:
        if blocked:
            signal.pthread_sigmask(signal.SIG_UNBLOCK,
                                   {signal.SIGINT, signal.SIGTERM,
                                    signal.SIGHUP})


def flush_records(world: World, records: list) -> None:
    """Commit the records past the commit point, then advance it.

    The commit point - the count of records already on disk - lives in
    world, one number shared by the round loop and the exit commit, so
    a record writes exactly once: the loop advances the point after
    each per-round commit and the exit commit at run exit appends only
    what no round committed. The caller ensures the tail ends at a
    stable boundary: no assistant record whose tool records are
    missing. commit_guard holds the signals
    off for the write and the advance."""
    with commit_guard():
        world.get("session").commit_events(
            records[world.get("committed"):])
        world.set("committed", len(records))


# --- steer inbox ----------------------------------------------------------------

STEER_INBOX = "wisp.steer.inbox"
"""The steer mailbox: <sessiondir>/wisp.steer.inbox. `wisp steer`
appends one JSON line per message; a live run renames the file away at
each round boundary and turns its lines into steered user records."""

STEER_TAG = (
    "Steering message added mid-run. It is not the turn prompt and"
    " it does not open a segment."
)
"""The one-line wire tag build_request puts before a steered user
message content. The stored record keeps the user's exact text, so
render and grep stay unchanged. The tag gives
the model the fact the code already has: the message is steering,
not the turn prompt, and it does not open a segment."""


def parse_records(text: str) -> list:
    """Parse one stored jsonl text into records. A line that fails
    json.loads is a mid-commit kill remnant; it is skipped."""
    records = []
    for line in text.split("\n"):
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if isinstance(rec, dict):
            records.append(rec)
    return records


def final_text_of(records: list) -> str | None:
    """The final text message of a turn: the text of its last
    `assistant` record. None when the record is absent, carries tool
    calls, or holds no text."""
    assistants = [rec for rec in records if rec.get("type") == "assistant"]
    if not assistants:
        return None
    output = assistants[-1].get("output") or []
    if any(block.get("type") == "tool_call" for block in output):
        return None
    text = "".join(block.get("text", "") for block in output
                   if block.get("type") == "text").strip()
    return text or None


def render_records(world: World, opts: Any) -> int:
    """Render the wisp run's stdout stream from stdin as plain text."""
    renderer = Renderer(world)
    for line in world.get("stdin").lines():
        renderer.render_line(line)
    renderer.finish()
    return 0


def render_past(world: World, opts: Any) -> int:
    """Render a past run: read <sessiondir>/wisp.jsonl and feed each stored
    record to the renderer as the same `data:` payload the live stream
    carried. Read-only: a broken line is skipped, a dangling tool_call
    renders without its result."""
    world.set("sessiondir", opts.sessiondir)
    fs = world.get("fs")
    path = opts.sessiondir + "/wisp.jsonl"
    records = parse_records(fs.read_text(path))
    renderer = Renderer(world)
    for line in records_to_stream(records):
        renderer.render_line(line)
    renderer.finish()
    return 0


def response_command(world: World, opts: Any) -> int:
    """`wisp response`: print the run's final assistant message as text.

    Single-shot and read-only: reads <DIR>/wisp.jsonl once, finds the
    final assistant message, prints its text to stdout. No backend
    traffic, no writes to the session dir. Run with -d DIR, or set
    WISP_SESSION_DIR; without both, wisp response fails.
    """
    world.set("sessiondir", opts.sessiondir)
    fs = world.get("fs")
    records = parse_records(fs.read_text(opts.sessiondir + "/wisp.jsonl"))
    text = final_text_of(records)
    if text is None:
        fail(world, "wisp response: no final assistant message in %s"
                    % opts.sessiondir)
    world.get("stdout").write(text + "\n")
    return 0


def usage_command(world: World, opts: Any) -> int:
    """Print the run's cumulative usage statistics as one line.

    Reads <DIR>/wisp.usage once, the model from <DIR>/wisp.run.json,
    and the model's entry from <DIR>/wisp.modelcfg. Single-shot: no
    following, no live data, no backend traffic. Missing config
    renders the <noprice>/<nocontext> placeholders.
    """
    world.set("sessiondir", opts.sessiondir)
    fs = world.get("fs")
    path = opts.sessiondir + "/wisp.usage"
    if not fs.exists(path):
        fail(world, "no wisp.usage in session dir: %s" % opts.sessiondir)
    model = world.get("session").load_run_setup(opts.sessiondir)["model"]
    chunks = read_usage_chunks(world, path)
    cfg = read_model_cfg(world, opts.sessiondir + "/wisp.modelcfg", model)
    world.get("stdout").write(usage_line(chunks, cfg) + "\n")
    return 0


def read_usage_chunks(world: World, path: str) -> dict:
    """Fold wisp.usage into one state dict; skip broken lines.

    net = prompt - cached - cache_write;
    last_total is the last chunk's total_tokens, not a sum. Lines
    written before the data:-prefix removal still parse.
    """
    state = {"turns": 0, "net": 0, "cache": 0, "write": 0,
             "out": 0, "reasoning": 0, "last_total": 0}
    for line in world.get("fs").read_text(path).split("\n"):
        text = line[len("data: "):] if line.startswith("data: ") else line
        try:
            chunk = json.loads(text)
        except ValueError:
            continue
        if not isinstance(chunk, dict):
            continue
        usage = chunk.get("usage") if isinstance(chunk.get("usage"), dict) else chunk
        details = usage.get("prompt_tokens_details") or {}
        out_details = usage.get("completion_tokens_details") or {}
        cached = int(details.get("cached_tokens") or 0)
        write = int(details.get("cache_write_tokens") or 0)
        prompt = int(usage.get("prompt_tokens") or 0)
        state["net"] += max(0, prompt - cached - write)
        state["cache"] += cached
        state["write"] += write
        state["out"] += int(usage.get("completion_tokens") or 0)
        state["reasoning"] += int(out_details.get("reasoning_tokens") or 0)
        state["turns"] += 1
        state["last_total"] = int(usage.get("total_tokens") or 0)
    return state


MODELCFG_FIELDS = ("context", "input", "output", "cacheRead", "cacheWrite")
"""The per-model keys wisp.modelcfg and WISP_LLM_MODEL_INFO_FILE share."""


def model_table_ok_of(table: Any) -> bool:
    """Whether one parsed table has the wisp.modelcfg shape: a
    non-empty JSON object of JSON objects, with a number in every
    known field it holds. An unknown extra key passes, so a wider
    provider table still loads."""
    if not isinstance(table, dict) or not table:
        return False
    for entry in table.values():
        if not isinstance(entry, dict):
            return False
        for name in MODELCFG_FIELDS:
            value = entry.get(name)
            if value is None:
                continue
            if isinstance(value, bool) or not isinstance(value, (int, float)):
                return False
    return True


def read_model_cfg(world: World, path: str, model: str) -> dict | None:
    """The model's wisp.modelcfg entry, or None when the file or the
    entry is missing or broken. Best effort, like refresh_model_cfg."""
    fs = world.get("fs")
    if not fs.exists(path):
        return None
    try:
        table = json.loads(fs.read_text(path))
    except ValueError:
        return None
    if not isinstance(table, dict) or not isinstance(table.get(model), dict):
        return None
    return table[model]


def fmt_tokens(n: int) -> str:
    """The token format: int, 1-dec k, rounded k, 1-dec M, M."""
    if n < 1000:
        return str(n)
    if n < 10000:
        return "%.1fk" % (n / 1000)
    if n < 1000000:
        return "%dk" % round(n / 1000)
    if n < 10000000:
        return "%.1fM" % (n / 1000000)
    return "%dM" % round(n / 1000000)


def usage_line(chunks: dict, cfg: dict | None) -> str:
    """One line, modeline style minus the cache-hit rate:
    in {net} out {out} ${cost} {used}/{window} {pct}%"""
    cost = "<noprice>"
    context = "<nocontext>"
    if cfg:
        if all(k in cfg for k in ("input", "output", "cacheRead", "cacheWrite")):
            cost = "$%.3f" % ((chunks["net"] * (cfg["input"] or 0)
                               + chunks["cache"] * (cfg["cacheRead"] or 0)
                               + chunks["write"] * (cfg["cacheWrite"] or 0)
                               + chunks["out"] * (cfg["output"] or 0)) / 1000000)
        window = int(cfg.get("context") or 0)
        if window > 0:
            pct = chunks["last_total"] / window * 100
            context = "%s/%s %.1f%%" % (fmt_tokens(chunks["last_total"]),
                                        fmt_tokens(window), pct)
    return "in %s out %s %s %s" % (fmt_tokens(chunks["net"]),
                                   fmt_tokens(chunks["out"]), cost, context)


# --- ls and grep ----------------------------------------------------------------

def scope_paths(world: World, opts: Any) -> list:
    """The session dirs of the scope: the project listdir by default, the
    registry roots under --global, the one subtree under --tree."""
    if opts.tree:
        return tree_sessions(world, opts.sessiondir)
    if opts.search_global:
        return global_sessions(world)
    return session_dirs(world, sessions_root(world))


def session_dirs(world: World, root: str) -> list:
    """The session dirs under one sessions root: every dir that holds
    wisp.jsonl. A missing or unreadable root yields no dirs."""
    fs = world.get("fs")
    try:
        entries = fs.listdir(root)
    except OSError:
        return []
    out = []
    for name in entries:
        path = os.path.join(root, name)
        if fs.isdir(path) and fs.exists(os.path.join(path, "wisp.jsonl")):
            out.append(path)
    return out


def global_sessions(world: World) -> list:
    """The sessions of every registered project: every symlink in the
    registry root resolves to one sessions root.
    Entries that are not symlinks, links that resolve to a missing
    dir, and a missing registry root contribute nothing."""
    fs = world.get("fs")
    out = []
    state = state_root(world)
    try:
        entries = fs.listdir(state)
    except OSError:
        return out
    for entry in entries:
        link = os.path.join(state, entry)
        if not fs.islink(link):
            continue
        target = fs.readlink(link)
        if not os.path.isabs(target):
            target = os.path.join(state, target)
        if fs.isdir(target):
            out.extend(session_dirs(world, target))
    return out


def tree_sessions(world: World, sessiondir: str) -> list:
    """The bound session dir plus every descendant.

    Each child id in the wisp.run.json children list resolves
    against the dir that holds the current session dir. A child joins when
    the dir exists and holds wisp.jsonl; a missing id is skipped. A
    broken wisp.run.json ends that branch: the dir stays in the
    universe, its children do not resolve. The visited set stops
    cycles."""
    fs = world.get("fs")
    out = []
    stack = [sessiondir]
    visited = set()
    while stack:
        path = fs.realpath(stack.pop())
        if path in visited:
            continue
        visited.add(path)
        out.append(path)
        for child_id in child_ids_of(world, path):
            child = os.path.join(os.path.dirname(path), child_id)
            if fs.isdir(child) and fs.exists(os.path.join(child, "wisp.jsonl")):
                stack.append(child)
    return out


def child_ids_of(world: World, path: str) -> list:
    """The children list of one session dir's wisp.run.json; [] when the
    file is missing, not JSON, not an object, or children is not a
    list."""
    try:
        setup = json.loads(world.get("fs").read_text(
            os.path.join(path, "wisp.run.json")))
    except (OSError, ValueError):
        return []
    if not isinstance(setup, dict):
        return []
    children = setup.get("children")
    return children if isinstance(children, list) else []


def sorted_sessions(world: World, paths: list) -> list:
    """Newest wisp.jsonl first; ties by path, descending. One order
    rule for all three scopes: sorting
    (mtime, path) ascending and reversing gives both."""
    fs = world.get("fs")
    return sorted(paths,
                  key=lambda path: (fs.mtime(path + "/wisp.jsonl"), path),
                  reverse=True)


def session_line(world: World, path: str) -> str:
    """One ls line: `<session-dir> model=<model> records=<n> last=<iso>`.

    model comes from wisp.run.json; a missing or broken file renders
    model=?. records is the parse_records count of wisp.jsonl. last is
    the wisp.jsonl mtime as local time, ISO format, seconds precision."""
    fs = world.get("fs")
    model = "?"
    try:
        setup = json.loads(fs.read_text(path + "/wisp.run.json"))
    except (OSError, ValueError):
        setup = None
    if isinstance(setup, dict) and setup.get("model"):
        model = str(setup["model"])
    records = parse_records(fs.read_text(path + "/wisp.jsonl"))
    mtime = datetime.fromtimestamp(fs.mtime(path + "/wisp.jsonl"))
    return "%s model=%s records=%d last=%s" % (
        path, model, len(records), mtime.isoformat(timespec="seconds"))


def ls_command(world: World, opts: Any) -> int:
    """`wisp ls`: one line per session of the scope, newest first.

    Read-only over every scope: the session dirs of the scope list as
    `<session-dir> model=<model> records=<n> last=<iso>`, newest
    wisp.jsonl first. Project scope is the default; --global reads the
    registry, --tree the descendants of one session dir. An empty
    universe prints nothing and exits 0."""
    out = world.get("stdout")
    for path in sorted_sessions(world, scope_paths(world, opts)):
        out.write(session_line(world, path) + "\n")
    return 0


def grep_command(world: World, opts: Any) -> int:
    """`wisp grep`: search the record text of the scope's sessions.

    The pattern is a Python regex; -i sets ignorecase. One line per
    matching record of every session dir in the scope, then exit 0; no
    matches exit 1. Read-only like ls; nothing is written
    anywhere."""
    pattern = grep_pattern(world, opts)
    out = world.get("stdout")
    found = False
    for path in sorted_sessions(world, scope_paths(world, opts)):
        for line in grep_session(world, path, pattern):
            out.write(line + "\n")
            found = True
    return 0 if found else 1


def grep_pattern(world: World, opts: Any):
    """The compiled pattern: re.search over the record search text, -i
    sets ignorecase. An invalid pattern fails with one stderr line and
    exit 1."""
    try:
        return re.compile(opts.pattern,
                          re.IGNORECASE if opts.ignorecase else 0)
    except re.error as exc:
        fail(world, "wisp grep: invalid pattern: %s" % exc)


def grep_session(world: World, path: str, pattern) -> list:
    """The matching lines of one session in log order.

    system, user and tool records search their content, assistant
    records the joined text of their text blocks, reasoning blocks
    excluded. One `<session-dir> <n> <type>: <first matching line>` per
    record, n from 1 in log order, the line cut to 200 characters."""
    records = parse_records(world.get("fs").read_text(path + "/wisp.jsonl"))
    out = []
    for n, rec in enumerate(records, 1):
        text = record_search_text(rec)
        if not pattern.search(text):
            continue
        out.append("%s %d %s: %s" % (path, n, rec.get("type"),
                                     record_match_line(text, pattern)[:200]))
    return out


def record_search_text(rec: dict) -> str:
    """The searchable text of one record: the content for system, user
    and tool records, the joined text of the text output blocks for an
    assistant record. Reasoning blocks are excluded."""
    if rec.get("type") == "assistant":
        return "\n".join(block.get("text") or ""
                         for block in rec.get("output") or []
                         if block.get("type") == "text")
    return rec.get("content") or ""


def record_match_line(text: str, pattern) -> str:
    """The first line of the search text that contains a match. A
    multiline pattern falls back to the line that holds the match."""
    for line in text.split("\n"):
        if pattern.search(line):
            return line
    match = pattern.search(text)
    start = text.rfind("\n", 0, match.start()) + 1
    end = text.find("\n", match.start())
    return text[start:] if end == -1 else text[start:end]


COMMANDS: dict[str, Callable[[World, Any], int]] = {
    "new": new_session,
    "run": run_agent_loop,
    "continue": continue_agent_loop,
    "steer": steer_command,
    "skill": skill_command,
    "agents-md": agents_md_command,
    "build-system-prompt": build_system_prompt,
    "render-live": render_records,
    "render-past": render_past,
    "usage": usage_command,
    "response": response_command,
    "ls": ls_command,
    "grep": grep_command,
}


# --- command-line parsing -------------------------------------------------------

class Opts:
    """Parsed command options: one instance per dispatched command."""

    def __init__(self):
        self.command = ""
        self.sub = ""        # skill ls | skill read SKILL | agents-md ls | read-all
        self.name = None     # new --name
        self.skill = None    # skill read SKILL
        self.model = None    # new -m
        self.thinking = None # new -t
        self.sessiondir = None   # run-family -d; resolved by resolve_sessiondir
        self.sysfile = None  # new -s
        self.parent = None   # new --parent
        self.context_guard = None  # run/continue --context-guard
        self.attach = []     # run --attach FILE, repeatable
        self.skills = False  # build-system-prompt --skills
        self.agents_md = False # build-system-prompt --agents-md
        self.wisp = False    # build-system-prompt --wisp
        self.env_in_system_prompt = False  # new --env-in-system-prompt
        self.search_global = False  # ls/grep --global
        self.tree = False           # ls/grep --tree
        self.ignorecase = False     # grep -i
        self.pattern = None         # grep PATTERN


SESSION_DIR_COMMANDS = ("run", "continue", "steer", "render-past",
                    "usage", "response")
"""Commands that bind -d and WISP_SESSION_DIR. new has no -d; render-live
listens on stdin only. skill, agents-md and build-system-prompt take
no -d: they walk from the CWD upwards and read the user-level
places. ls and grep join them only in --tree scope; project and
global scope take neither."""


def resolve_sessiondir(world: World, opts: Any) -> None:
    """Set opts.sessiondir from -d, else WISP_SESSION_DIR, then validate it.

    There is no CWD default: a run-family command without -d and
    WISP_SESSION_DIR fails. A set but empty WISP_SESSION_DIR fails unless -d
    overrides it; -d has the higher precedence and does not consult
    the env.

    ls and grep resolve a session dir only in --tree scope: project
    and global scope take neither -d nor WISP_SESSION_DIR, so the guard
    here also passes them through when
    opts.tree is unset.
    """
    if opts.command not in SESSION_DIR_COMMANDS and not opts.tree:
        return
    if not opts.sessiondir:
        env = world.get("env").get("WISP_SESSION_DIR")
        env_dir = (env or "").strip()
        if not env_dir:
            if env is not None:
                fail(world, "wisp %s: WISP_SESSION_DIR is set but empty"
                            % opts.command)
            fail(world, "wisp %s: pass -d DIR, or set WISP_SESSION_DIR"
                        % opts.command)
        opts.sessiondir = env_dir
    validate_sessiondir(world, opts)


def validate_sessiondir(world: World, opts: Any) -> None:
    """The resolved session dir, by -d or by WISP_SESSION_DIR, must exist and
    hold wisp.jsonl."""
    if not world.get("fs").exists(opts.sessiondir):
        fail(world, "wisp %s: session dir does not exist: %s"
                    % (opts.command, opts.sessiondir))
    if not world.get("fs").exists(opts.sessiondir + "/wisp.jsonl"):
        fail(world, "wisp %s: no wisp.jsonl in session dir: %s"
                    % (opts.command, opts.sessiondir))


def parse_args(world: World, argv: list[str]) -> Any:
    """Split argv into (command, opts). Subcommands travel in opts.sub.

    -d DIR names the session directory for run, continue, render-past,
    usage and response. Without -d, WISP_SESSION_DIR names it; without
    both, the command fails. skill, agents-md and build-system-prompt do not
    take -d; they keep their CWD-walk scope.
    """
    opts = Opts()
    opts.command = argv[0]
    if opts.command not in COMMANDS:
        no_such_command(world, opts.command)
    rest = argv[1:]
    if "-h" in rest or "--help" in rest:
        print_command_help(world, opts.command)
    if opts.command in ("skill", "agents-md"):
        if not rest:
            fail(world, "wisp %s: use %s" % (opts.command, (
                "ls, or read SKILL" if opts.command == "skill" else "ls or read-all")))
        if opts.command == "skill" and rest[0] not in ("ls", "read"):
            unknown_sub(world, opts.command, rest[0])
        if opts.command == "agents-md" and rest[0] not in ("ls", "read-all"):
            unknown_sub(world, opts.command, rest[0])
        opts.sub = rest[0]
        rest = rest[1:]
        if opts.command == "skill" and opts.sub == "read":
            if not rest:
                fail(world, "wisp skill read: pass a SKILL name")
            opts.skill = rest[0]
            rest = rest[1:]

    if opts.command in ("ls", "grep"):
        positional = []
        while rest:
            arg = rest.pop(0)
            if arg == "-d":
                if not rest:
                    fail(world, "wisp %s: -d needs a value" % opts.command)
                opts.sessiondir = rest.pop(0)
            elif arg == "--global":
                opts.search_global = True
            elif arg == "--tree":
                opts.tree = True
            elif arg == "-i":
                opts.ignorecase = True
            else:
                positional.append(arg)
        if opts.command == "grep":
            if len(positional) != 1:
                fail(world, "wisp grep: pass exactly one PATTERN")
            opts.pattern = positional[0]
        elif positional:
            fail(world, "wisp ls: takes no arguments")
        elif opts.ignorecase:
            fail(world, "wisp ls: -i is a grep flag")
        rest = []

    valued = {"--name": "name", "-m": "model", "-t": "thinking",
              "-d": "sessiondir", "-s": "sysfile", "--parent": "parent",
              "--context-guard": "context_guard"}
    while rest:
        arg = rest.pop(0)
        if arg.startswith("--context-guard="):
            setattr(opts, "context_guard", arg.split("=", 1)[1])
        elif arg in valued:
            if not rest:
                fail(world, "wisp: %s needs a value" % arg)
            setattr(opts, valued[arg], rest.pop(0))
        elif arg == "--skills":
            opts.skills = True
        elif arg == "--agents-md":
            opts.agents_md = True
        elif arg == "--wisp":
            opts.wisp = True
        elif arg == "--env-in-system-prompt":
            opts.env_in_system_prompt = True
        elif arg == "--attach":
            if not rest:
                fail(world, "wisp: --attach needs a value")
            opts.attach.append(rest.pop(0))
        else:
            fail(world, "wisp %s: unknown argument %s" % (opts.command, arg))

    if opts.command == "new":
        if opts.env_in_system_prompt and not opts.sysfile:
            fail(world, "wisp new: --env-in-system-prompt needs -s SYSFILE")
        if not opts.model:
            fail(world, "wisp new: -m MODEL is required")
        if opts.sysfile and not world.get("fs").exists(opts.sysfile):
            fail(world, "system file not found: %s" % opts.sysfile)
    if opts.context_guard is not None:
        if opts.command not in ("run", "continue"):
            fail(world, "wisp %s: --context-guard is a flag of"
                        " wisp run and wisp continue" % opts.command)
        parse_context_guard(world, opts.context_guard)
    if opts.command in ("skill", "agents-md", "build-system-prompt"):
        if opts.sessiondir:
            fail(world, "wisp %s: does not take -d" % opts.command)
    if opts.command in ("run", "continue", "steer", "render-past",
                        "usage", "response"):
        if opts.model or opts.thinking or opts.sysfile or opts.parent:
            fail(world, "wisp %s: takes only -d; model, thinking, the"
                        " system record and the parent link live in the"
                        " session dir" % opts.command)
    if opts.command in ("ls", "grep"):
        if opts.sessiondir and not opts.tree:
            fail(world, "wisp %s: -d works only with --tree" % opts.command)
        if opts.search_global and opts.tree:
            fail(world, "wisp %s: one scope: --global and --tree"
                        " together" % opts.command)
    resolve_sessiondir(world, opts)
    return opts.command, opts


