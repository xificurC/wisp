class HttpError(Exception):
    """One HTTP failure, with the status and a cause text in the message."""


HTTP_TIMEOUT = 600

REQUEST_ID_HEADERS = ("x-request-id", "x-litellm-request-id",
                      "request-id", "x-amzn-requestid")


def request_id_of_headers(headers: Any) -> str:
    """The endpoint request id from one response's headers, or ''.

    Proxies name the correlation header differently: LiteLLM sets
    x-litellm-request-id, a native OpenAI service sets x-request-id.
    Names compare lowercased, the well-known ones win in order, and
    any other name that ends in request-id is the fallback. A
    response with no such header leaves the field empty, so the log
    line stays short."""
    try:
        pairs = list(headers.items())
    except AttributeError:
        return ""
    found = {}
    for name, value in pairs:
        key = str(name).lower()
        if value and key not in found:
            found[key] = str(value)
    for name in REQUEST_ID_HEADERS:
        if name in found:
            return found[name]
    for key, value in found.items():
        if key.endswith("request-id"):
            return value
    return ""


class Http:
    """Direct HTTP on urllib. The network reaches wisp only through this."""
    def __init__(self, world: World):
        self._world = world


    def post_stream(self, url: str, headers: dict, body: dict,
                    meta: dict | None = None) -> Iterator[str]:
        """POST one request and yield its SSE lines.

        `meta`, when given, receives the response `status` and the
        endpoint `request_id` before the first line, and on an HTTP
        error before the HttpError rises, so a caller can log the
        correlation id of a request whose body carried no answer."""
        request = urllib.request.Request(
            url, data=json.dumps(body).encode("utf-8"),
            headers=dict(headers), method="POST")
        try:
            response = urllib.request.urlopen(request, timeout=HTTP_TIMEOUT)
        except urllib.error.HTTPError as exc:
            if meta is not None:
                meta["status"] = exc.code
                meta["request_id"] = request_id_of_headers(exc.headers)
            snippet = exc.read(4096).decode("utf-8", "replace").strip()
            raise HttpError("%s %s" % (exc.code, snippet or exc.reason)) from exc
        except (urllib.error.URLError, OSError) as exc:
            raise HttpError(str(exc)) from exc
        if meta is not None:
            meta["status"] = getattr(response, "status", None)
            meta["request_id"] = request_id_of_headers(
                getattr(response, "headers", None))
        with response:
            for raw in response:
                yield raw.decode("utf-8", "replace").rstrip("\r\n")

    def post_json(self, url: str, headers: dict, body: dict,
                  meta: dict | None = None) -> Any:
        """POST one request and return its whole JSON body.

        The request, the error wrapping and the meta fill match
        post_stream. One read and one parse; a body that does not
        parse raises HttpError("not a JSON response: ..."). post_stream
        splits lines, so a pretty-printed body would break it."""
        request = urllib.request.Request(
            url, data=json.dumps(body).encode("utf-8"),
            headers=dict(headers), method="POST")
        try:
            response = urllib.request.urlopen(request, timeout=HTTP_TIMEOUT)
        except urllib.error.HTTPError as exc:
            if meta is not None:
                meta["status"] = exc.code
                meta["request_id"] = request_id_of_headers(exc.headers)
            snippet = exc.read(4096).decode("utf-8", "replace").strip()
            raise HttpError("%s %s" % (exc.code, snippet or exc.reason)) from exc
        except (urllib.error.URLError, OSError) as exc:
            raise HttpError(str(exc)) from exc
        if meta is not None:
            meta["status"] = getattr(response, "status", None)
            meta["request_id"] = request_id_of_headers(
                getattr(response, "headers", None))
        with response:
            try:
                return json.loads(response.read().decode("utf-8", "replace"))
            except ValueError as exc:
                raise HttpError("not a JSON response: %s" % exc) from exc

    def get_json(self, url: str, headers: dict) -> Any:
        request = urllib.request.Request(url, headers=dict(headers), method="GET")
        try:
            response = urllib.request.urlopen(request, timeout=HTTP_TIMEOUT)
        except urllib.error.HTTPError as exc:
            raise HttpError("%s %s" % (exc.code, exc.reason)) from exc
        except (urllib.error.URLError, OSError) as exc:
            raise HttpError(str(exc)) from exc
        with response:
            try:
                return json.loads(response.read().decode("utf-8", "replace"))
            except ValueError as exc:
                raise HttpError("not a JSON response: %s" % exc) from exc


DRAIN_GRACE_SECONDS = 1  # bound on the post-kill / post-child-exit drain


class Executor:
    """Runs one argv with a byte cap and a lazy spill file.

    run(argv, seconds, cap_bytes, spill_path_of) -> (rc, head, spill):
    stdout (with stderr joined) reads through a select loop, deadline
    enforced by the clock service; a timeout kills the child and rc is
    124. The head holds at most cap_bytes and is filled to exactly
    cap_bytes on overflow; the moment output passes
    cap_bytes, a spill file is created exactly once through
    spill_path_of() and the full output streams into it, head included.
    With no overflow the spill is None and no file exists, on a timeout
    too: a fitting partial rides in the head, so refetching it from a
    spill would add no information. stdin is /dev/null. The child runs
    in its own process session, so a timeout can SIGKILL the whole
    tree: a `bash -c 'a | b | while'` pipeline keeps a subshell alive
    after the direct child dies, and that subshell still holds the
    stdout pipe.

    output(argv, seconds=5) -> (rc, stdout_text): the small-scale tool
    IO (git discovery), captured and decoded, no spill machinery.
    """

    def __init__(self, world: World):
        self._world = world

    def output(self, argv: list, seconds: int = 5) -> tuple:
        try:
            proc = subprocess.run(argv, capture_output=True, text=True, timeout=seconds)
        except subprocess.TimeoutExpired:
            return 124, ""
        return proc.returncode, proc.stdout or ""

    def run(self, argv: list, seconds: int, cap_bytes: int, spill_path_of: Callable) -> tuple:
        proc = subprocess.Popen(
            argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL, start_new_session=True)
        head = bytearray()
        spill_path = [None]
        spill_out = [None]

        def route(chunk: bytes) -> None:
            if spill_out[0] is not None:
                spill_out[0].write(chunk)
            else:
                space = cap_bytes - len(head)
                if space >= len(chunk):
                    head.extend(chunk)
                    return
                spill_path[0] = spill_path_of()
                spill_out[0] = open(spill_path[0], "wb")
                spill_out[0].write(bytes(head))
                spill_out[0].write(chunk)
                if space > 0:
                    head.extend(chunk[:space])

        fd = proc.stdout.fileno()
        deadline = self._world.get("clock").monotonic() + seconds
        timed_out = False
        abandoned = False

        def drain_grace() -> None:
            """Drain the pipe under the grace bound. Every read is guarded
            by a select; on grace expiry stop and mark the output
            abandoned (an escaped writer still holds the pipe)."""
            nonlocal abandoned
            grace_end = self._world.get("clock").monotonic() + DRAIN_GRACE_SECONDS
            while True:
                remaining = grace_end - self._world.get("clock").monotonic()
                if remaining <= 0:
                    abandoned = True
                    return
                if not select.select([fd], [], [], remaining)[0]:
                    abandoned = True
                    return
                chunk = os.read(fd, 65536)
                if not chunk:
                    return
                route(chunk)

        try:
            while True:
                remaining = deadline - self._world.get("clock").monotonic()
                if remaining <= 0:
                    timed_out = True
                    try:
                        os.killpg(proc.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                    drain_grace()
                    break
                if proc.poll() is not None:
                    drain_grace()
                    break
                if not select.select([fd], [], [], min(remaining, DRAIN_GRACE_SECONDS))[0]:
                    continue
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                route(chunk)
        finally:
            if spill_out[0] is not None:
                spill_out[0].close()
            proc.stdout.close()
        # The reap is not optional: until wait() runs, returncode is None
        # and would fold a real exit code into 0 on the None-or-0 fold.
        proc.wait()
        rc = 124 if timed_out else (proc.returncode or 0)
        return rc, bytes(head), spill_path[0], abandoned


def git_root(world: World) -> str:
    """The git toplevel from `git rev-parse --show-toplevel`, else "".
    Handles worktrees, submodules and a set GIT_DIR; outside a repo it
    returns empty and callers fall back."""
    rc, text = world.get("exec").output(["git", "rev-parse", "--show-toplevel"])
    return text.strip() if rc == 0 and text.strip() else ""


def env_impl(world: World) -> Any:
    """get(name, default) -> one environment value; IO through the world."""
    return os.environ


def _int_or(value: Any, default: int) -> int:
    """Floor a number; take the default on a missing or non-number value."""
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        return int(value)
    return default


